/* ==========================================================================
   rain-ui — 全局样式入口
   --------------------------------------------------------------------------
   引入顺序即层叠优先级：字体 → tokens → 排版 → 环境光层 → 基础原子 → 组件。
   只有「基础原子 + 通用布局外壳」在这里，业务视图样式（Home / Settings /
   Chat / Terminal）不进组件库。

   使用方式（二选一）：
     1. bundler 中 `import "rain-ui/styles.css"`（本文件是打包入口）；
     2. 或直接引入打包产物 `node_modules/rain-ui/dist/rain-ui.css`。
   ========================================================================== */

/* 1. 基础规范 */

/* ---- ./tokens.css ---- */
/**
 * ============================================================================
 * Android Toolkit UI Design Tokens
 * Shared V2 surfaces, readable controls and semantic colors for both themes.
 * ============================================================================
 */

:root {
  --font-display: -apple-system, BlinkMacSystemFont, "Segoe UI Variable", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
  --font-sans: var(--font-display);
  --font-mono: "JetBrains Mono", "Cascadia Mono", "Cascadia Code", Consolas, monospace;

  --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-out: cubic-bezier(0, 0, 0.2, 1);

  /* Component outlines stay transparent in every theme; keep their reserved
     width so theme changes and removing decoration do not resize the layout.
     Content dividers and keyboard focus use their own tokens. */
  --card-radius: 18px;
  /* Only form fields use a thin halo; actions respond with background fills. */
  --input-hover-ring: 0 0 0 2px color-mix(in srgb, var(--accent-primary) 16%, transparent);
  --input-hover-shadow: var(--input-hover-ring), var(--input-inner-shadow);
  --card-hover-shadow: var(--shadow-lg);
  --card-footer-bg: transparent;
  --markdown-code-surface: var(--ambient-glow), var(--markdown-code-bg);
  --control-radius: 10px;
  --control-height: 32px;
  --control-height-sm: 28px;
  --control-height-md: 32px;
  --control-height-lg: 38px;

  --radius-sm: 8px;
  --radius-base: 10px;
  --radius-lg: 18px;
  --radius-full: 9999px;

  --transition-fast: 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-base: 0.22s cubic-bezier(0.16, 1, 0.3, 1);

  /* card-showcase.html: glass track, secondary fill and accent selected text. */
  --segmented-bg: var(--input-bg-sunken);
  --segmented-text: var(--control-text);
  --segmented-hover-bg: color-mix(in srgb, var(--segmented-bg) 94%, var(--text-primary));
  --segmented-active-bg: var(--btn-secondary-bg);
  --segmented-active-hover-bg: var(--btn-secondary-hover);
  --segmented-active-text: var(--accent-primary);
  --segmented-active-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  --btn-primary-rim: inset 0 1px 1px 0 rgba(255, 255, 255, 0.25);

  --btn-danger-active-bg: color-mix(in srgb, var(--danger-text) 18%, var(--bg-canvas));
  --btn-success-bg: var(--status-success-bg);
  --btn-success-hover: color-mix(in srgb, var(--success-text) 12%, var(--bg-canvas));
  --btn-success-text: var(--status-success-text);
  --control-text: color-mix(in srgb, var(--text-secondary) 80%, var(--text-primary));
  --surface-inset-bg: color-mix(in srgb, var(--bg-surface) 98%, var(--text-primary));
  --surface-action-bg: color-mix(in srgb, var(--bg-surface) 96%, var(--text-primary));
  --surface-action-hover-bg: color-mix(in srgb, var(--bg-surface) 91%, var(--text-primary));
  --surface-action-active-bg: color-mix(in srgb, var(--bg-surface) 86%, var(--text-primary));
  --status-success-bg: color-mix(in srgb, var(--success-text) 6%, var(--bg-canvas));
  --status-success-text: color-mix(in srgb, var(--success-text) 88%, var(--text-primary));
  --status-warning-bg: color-mix(in srgb, var(--warning-text) 6%, var(--bg-canvas));
  --status-warning-text: color-mix(in srgb, var(--warning-text) 88%, var(--text-primary));
  --status-danger-bg: color-mix(in srgb, var(--danger-text) 6%, var(--bg-canvas));
  --status-danger-text: color-mix(in srgb, var(--danger-text) 88%, var(--text-primary));
  --status-info-bg: var(--btn-primary-bg);
  --status-info-text: var(--btn-primary-text);
  --status-neutral-bg: var(--bg-surface);
  --status-neutral-text: var(--control-text);
  --focus-ring: 0 0 0 2px var(--accent-primary);
  --divider-dashed: 1px dashed var(--divider-color);
  --overlay-bg: color-mix(in srgb, #000000 36%, transparent);
  --tooltip-bg: var(--text-primary);
  --tooltip-text: var(--bg-canvas);
  --toast-bg: var(--popover-bg);
  --toast-text: var(--text-primary);
  --toast-shadow: var(--popover-shadow);
  --progress-track-bg: color-mix(in srgb, var(--text-primary) 10%, var(--bg-canvas));
  --terminal-foreground: var(--text-primary);
  --badge-bg: var(--status-neutral-bg);
  --badge-text: var(--status-neutral-text);
  --send-button-bg: var(--text-primary);
  --send-button-text: var(--bg-canvas);
  --send-button-hover: color-mix(in srgb, var(--text-primary) 85%, var(--bg-canvas));
  /* Paired palettes for controls embedded in an input, and shared tables. */
  --input-muted: color-mix(in srgb, var(--input-bg-focus) 32%, var(--input-text));
  --input-action-bg: color-mix(in srgb, var(--input-bg-sunken) 86%, var(--input-text));
  --input-action-hover: color-mix(in srgb, var(--input-bg-sunken) 76%, var(--input-text));
  --input-action-text: var(--input-text);
  /* Flat search fields are separate from cards and page panels. */
  --input-surface-bg: var(--input-bg-sunken);
  --input-surface-hover-bg: var(--input-bg-hover);
  --input-surface-focus-bg: var(--input-bg-focus);
  --composer-bg: var(--input-bg-sunken);
  --composer-text: var(--input-text);
  --composer-muted: var(--input-muted);
  --composer-control-bg: color-mix(in srgb, var(--composer-bg) 86%, var(--composer-text));
  --composer-control-hover: var(--button-hover-bg);
  --composer-control-text: var(--input-action-text);
  --composer-send-bg: var(--send-button-bg);
  --composer-send-hover: var(--send-button-hover);
  --composer-send-text: var(--send-button-text);
  --composer-disabled-bg: var(--composer-control-bg);
  --composer-disabled-text: var(--composer-muted);
  --composer-ring-track: color-mix(in srgb, var(--composer-bg) 72%, var(--composer-text));
  --composer-divider: color-mix(in srgb, var(--composer-bg) 88%, var(--composer-text));
  --composer-warning: var(--warning-text);
  --composer-danger: var(--danger-text);
  --composer-permission-bg: color-mix(in srgb, var(--composer-bg) 92%, var(--composer-danger));
  --composer-permission-hover: color-mix(in srgb, var(--composer-bg) 86%, var(--composer-danger));
  --table-bg: var(--bg-surface);
  --table-text: var(--text-primary);
  --table-header-bg: color-mix(in srgb, var(--table-bg) 92%, var(--accent-primary));
  --table-header-text: var(--table-text);
  --table-stripe-bg: color-mix(in srgb, var(--table-bg) 97.5%, var(--accent-primary));
  --table-hover-bg: color-mix(in srgb, var(--table-bg) 93%, var(--accent-primary));
  --table-divider: color-mix(in srgb, var(--table-bg) 92%, var(--table-text));
  --terminal-tabs-bg: color-mix(in srgb, var(--bg-surface) 94%, var(--text-primary));
  --terminal-surround-bg: color-mix(in srgb, var(--bg-canvas) 94%, var(--text-primary));
  --session-tab-bg: color-mix(in srgb, var(--terminal-tabs-bg) 96%, var(--text-primary));
  --session-tab-text: var(--control-text);
  --session-tab-hover-bg: color-mix(in srgb, var(--session-tab-bg) 94%, var(--text-primary));
  --session-tab-active-bg: color-mix(in srgb, var(--session-tab-bg) 92%, var(--text-primary));
  --session-tab-active-hover-bg: color-mix(in srgb, var(--session-tab-bg) 88%, var(--text-primary));
  --session-tab-active-text: var(--text-primary);
  --task-surface: var(--bg-card);
  --task-title: var(--text-primary);
  --task-detail: var(--control-text);
  --task-action: var(--control-text);
  --task-action-hover-bg: var(--segmented-hover-bg);
  --inference-accent: var(--btn-primary-text);
  --inference-track: var(--input-bg-sunken);
  --inference-fill: #9a59e0;
  --inference-fill-deep: #4a3584;
  --inference-fill-highlight: #e1b7ff;
  --inference-fill-warm: #f2c94c;
  --inference-spark: #f8e2ff;
  --inference-spark-warm: #ffe39a;
  --inference-thumb: var(--text-primary);
  --inference-knob-bg: #ffffff;
  --inference-thumb-shadow: 0 1px 4px color-mix(in srgb, #000000 24%, transparent);
  --workspace-panel-bg: var(--page-pane-bg);
  --workspace-panel-text: var(--text-primary);
  --workspace-panel-muted: var(--control-text);
  --pane-divider-color: color-mix(in srgb, var(--text-primary) 10%, transparent);
  --pane-divider-active-color: color-mix(in srgb, var(--text-primary) 30%, transparent);

  /* Markdown surfaces stay distinct from the conversation canvas in every theme. */
  --markdown-inline-code-bg: color-mix(in srgb, var(--bg-canvas) 88%, var(--text-primary));
  --markdown-code-bg: color-mix(in srgb, var(--context-navigation-bg) 95%, var(--text-primary));
  --markdown-code-text: var(--text-primary);
  --markdown-quote-bg: var(--markdown-code-bg);
  --markdown-quote-text: var(--text-primary);
  --markdown-table-heading-bg: var(--table-header-bg);
  --markdown-divider: color-mix(in srgb, var(--text-primary) 12%, transparent);
  --tool-input-bg: var(--markdown-inline-code-bg);
  --tool-output-bg: var(--markdown-code-bg);
  --tool-code-text: var(--markdown-code-text);
  --tool-detail-muted: var(--control-text);
  --tool-detail-divider: var(--markdown-divider);
  --tool-state-bg: color-mix(in srgb, var(--bg-canvas) 96%, var(--text-primary));
  --tool-state-text: var(--control-text);
  --tool-state-muted: var(--text-tertiary);
  --property-surface: var(--bg-surface);
  --property-hover-bg: var(--bg-hover);
  --property-divider: var(--divider-color);
  --property-value-text: var(--text-primary);
  --property-unknown-text: var(--control-text);
  --tool-scrollbar-thumb: var(--scrollbar-thumb);
  --tool-scrollbar-thumb-hover: var(--scrollbar-thumb-hover);
  --processing-status-text: var(--control-text);
  --processing-status-icon: var(--accent-primary);
  --processing-status-shimmer: color-mix(in srgb, var(--accent-primary) 18%, transparent);
  --execution-status-text: var(--text-secondary);
  --row-hover-bg: color-mix(in srgb, var(--bg-card) 97.5%, var(--text-primary));
  --page-header-bg: var(--bg-canvas);
  --page-pane-bg: var(--bg-canvas);
  --switch-thumb-bg: var(--control-checked-mark);
  --switch-thumb-shadow: 0 2px 5px color-mix(in srgb, #000000 25%, transparent);
}

/* ============================================================================
 * 1. 深色模式 (DARK MODE - 默认) - macOS Studio 苹果原生专业工作台
 * ============================================================================ */
:root {
  /* UA 默认滚动条/原生控件跟随主题：不声明时 WebView2 一律按 light 渲染，
     所有没写滚动条样式的滚动元素在暗色主题下都是刺眼的浅色滚动条。 */
  color-scheme: dark;
  --bg-ambient: #090b10;
  --bg-app: #151a23;
  --context-navigation-bg: #151a23;
  --context-navigation-divider: rgba(255, 255, 255, 0.07);
  --button-hover-bg: rgba(255, 255, 255, 0.08);
  --button-hover-text: var(--text-primary);
  --chrome-hover-text: var(--chrome-ink);
  --selection-text: var(--text-primary);
  --input-text: var(--text-primary);
  --input-hover-text: var(--text-primary);
  --rail-hover-bg: rgba(255, 255, 255, 0.08);
  --rail-active-bg: rgba(99, 102, 241, 0.22);
  --topbar-bg: var(--bg-ambient);
  --bg-base: transparent;
  --bg-canvas: #0b0e13;
  --page-header-bg: #0b0e13;
  --page-pane-bg: #0b0e13;
  --workspace-panel-bg: #121720;
  --chrome-ink: #f8fafc;
  --chrome-muted: #94a3b8;
  --chrome-hover: rgba(255, 255, 255, 0.08);
  --ambient-glow: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, rgba(99, 102, 241, 0.03) 30%, transparent 60%);
  --card-bg: linear-gradient(145deg, rgba(31, 36, 46, 0.98) 0%, rgba(22, 26, 35, 0.98) 100%);
  --bg-card: var(--card-bg);
  --chat-user-message-bg: color-mix(in srgb, var(--accent-primary) 13%, var(--bg-canvas));
  --bg-panel: #12151e;
  --bg-card-hover: var(--bg-card);
  --card-blur: 28px;
  --bg-surface: #171c28;
  --bg-muted: var(--bg-surface);
  --bg-hover: rgba(255, 255, 255, 0.06);
  --bg-selected: rgba(99, 102, 241, 0.22);
  --bg-input: rgba(255, 255, 255, 0.05);
  --card-rim: inset 0 1px 1px 0 rgba(255, 255, 255, 0.16);
  --accent-color: var(--accent-primary);
  --btn-primary-bg: #6366f1;
  --btn-primary-hover: #4f46e5;
  --btn-primary-text: #ffffff;
  --btn-confirm-bg: #6366f1;
  --btn-confirm-hover: #4f46e5;
  --btn-confirm-text: #ffffff;

  /* 下拉浮层面板专属：实心深蓝黑防穿透 */
  --popover-bg: rgba(18, 21, 28, 0.98);
  --popover-border: 1px solid transparent;
  --popover-shadow: 0 24px 50px rgba(0, 0, 0, 0.65), 0 4px 16px rgba(0, 0, 0, 0.35);
  --popover-item-hover: rgba(255, 255, 255, 0.08);
  --popover-item-active-bg: rgba(99, 102, 241, 0.22);
  --popover-item-active-text: #a5b4fc;

  /* ── 表单控件 (暗色) ───────────────────────────────────────────────────
     同样是"比所在表面亮一档"的冷调阶梯。用的不是纯白叠加（那会偏灰发闷，
     且在 #171c28 的卡片上几乎看不出来），而是带蓝的 slate 提亮：
       #12151e -> #1a2030 -> #202839 -> #232b3d
     配合 --bg-canvas #0b0e13 / --bg-surface #171c28，每一档都能立住边界。
     focus 继续抬升而不是回落，因为暗色下"浮起"要靠变亮来表达。 */
  --input-bg-sunken: #1a2030;
  --input-bg-hover: #202839;
  --input-bg-focus: #232b3d;
  --input-bg: var(--input-bg-sunken);
  --input-surface-bg: #1a2030;
  --input-surface-hover-bg: #202839;
  --input-surface-focus-bg: #232b3d;
  --control-unchecked-bg: rgba(255, 255, 255, 0.14);
  --control-checked-bg: var(--accent-primary);
  --control-checked-mark: #ffffff;
  --input-placeholder: var(--input-muted);
  --input-focus-border: color-mix(in srgb, var(--input-bg-sunken) 84%, var(--text-primary));
  --input-focus-ring: 0 0 0 2px color-mix(in srgb, var(--accent-primary) 32%, transparent);
  --input-border: 1px solid color-mix(in srgb, var(--input-bg-sunken) 86%, var(--text-primary));
  --input-lift: 0 1px 2px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.22);
  --input-lift-hover: 0 2px 5px rgba(0, 0, 0, 0.42), 0 5px 14px rgba(0, 0, 0, 0.28);
  --input-rim: inset 0 1px 0 rgba(255, 255, 255, 0.10);
  --input-glass: var(--input-lift), var(--input-rim);
  --input-inner-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.24);

  --terminal-canvas-bg: #202020;
  --terminal-cursor: #ededed;
  --terminal-selection: #494949;
  /* 终端 dim（SGR 2）文字的保留强度：xterm 默认只留 50% 不透明度，
     亮色下会淡到看不清，所以亮色单独调高（见 styles/terminal.css）。 */
  --terminal-dim-strength: 50%;
  --terminal-dim-ansi-strength: 50%;
  /* 终端前景色的最低对比度（WCAG）。暗色底本身够暗，保持 xterm 默认不干预。 */
  --terminal-contrast-ratio: 1;
  --terminal-black: #8b949e;
  --terminal-red: #ff7b72;
  --terminal-green: #7ee787;
  --terminal-yellow: #d29922;
  --terminal-blue: #79c0ff;
  --terminal-magenta: #d2a8ff;
  --terminal-cyan: #76e3ea;
  --terminal-white: #c9d1d9;
  --terminal-bright-black: #a0a0a0;
  --terminal-bright-red: #ffa198;
  --terminal-bright-green: #aff5b4;
  --terminal-bright-yellow: #e3b341;
  --terminal-bright-blue: #a5d6ff;
  --terminal-bright-magenta: #e2c5ff;
  --terminal-bright-cyan: #b3f0ff;
  --terminal-bright-white: #ffffff;
  --code-background: var(--bg-canvas);
  --code-foreground: var(--text-primary);
  --code-line-number: var(--text-tertiary);
  --code-selection: #494949;
  --code-find-match: #35516d;
  --code-find-current: #436c94;
  --code-diff-added-bg: #17392b;
  --code-diff-removed-bg: #412529;
  --code-diff-added-text: #7dd3a4;
  --code-diff-removed-text: #f5a1a8;
  --code-syntax-comment: var(--text-tertiary);
  --code-syntax-keyword: #ef9d89;
  --code-syntax-literal: #efaa68;
  --code-syntax-type: #8fc6ff;
  --code-syntax-string: #6fc6a5;
  --code-syntax-attribute: #8fc6ff;
  --code-syntax-number: #efaa68;
  --code-syntax-function: #8fc6ff;
  --code-syntax-builtin: #f3b77d;
  --code-syntax-meta: #f3b77d;
  --terminal-scrollbar-thumb: rgba(148, 163, 184, 0.72);
  --terminal-scrollbar-thumb-hover: rgba(226, 232, 240, 0.9);

  /* 按钮系统 - 完全对齐 showcase 亚克力磨砂物理底座，border 极淡近透明，hover 仅变背景 */
  --btn-secondary-bg: rgba(255, 255, 255, 0.06);
  --btn-secondary-hover: rgba(255, 255, 255, 0.12);
  --btn-secondary-border: rgba(255, 255, 255, 0.10);
  --btn-secondary-text: var(--text-primary);
  --btn-subtle-bg: transparent;
  --btn-subtle-hover: rgba(255, 255, 255, 0.08);
  --btn-subtle-border: transparent;
  --btn-subtle-text: var(--text-secondary);

  /* 危险按钮核心：纯正鲜红实体 (#EF4444) + 纯白文字 */
  --btn-danger-default-bg: var(--status-danger-bg);
  --btn-danger-default-text: var(--status-danger-text);
  --btn-danger-default-border: transparent;
  --btn-danger-default-glow: 0 4px 14px rgba(239, 68, 68, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  --btn-danger-hover-bg: color-mix(in srgb, var(--danger-text) 12%, var(--bg-canvas));
  --btn-danger-hover-text: #ffffff;
  --btn-danger-hover-border: transparent;
  --btn-danger-hover-glow: 0 6px 24px rgba(239, 68, 68, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.45);
  --btn-danger-bg: var(--status-danger-bg);
  --btn-danger-hover: color-mix(in srgb, var(--danger-text) 12%, var(--bg-canvas));
  --btn-danger-text: var(--status-danger-text);

  /* 品牌主色 - 方案 2: 雾霾冷靛青 (Slate Indigo) */
  --accent-gradient: linear-gradient(135deg, #6366f1, #4f46e5);
  --accent-primary: #6366f1;
  --accent-hover: #4f46e5;
  --accent-glow: 0 4px 16px rgba(99, 102, 241, 0.35);
  --accent-subtle: rgba(99, 102, 241, 0.12);
  --accent-border: rgba(99, 102, 241, 0.35);
  --accent-text: #ffffff;

  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-tertiary: #64748b;
  --text-muted: #a0a0a0;
  --text-quaternary: #939393;
  --success-text: #71d2a6;
  --warning-text: #e6bc66;
  --danger-text: #fa9292;
  --status-success: var(--success-text);
  --status-warning: var(--warning-text);
  --status-danger: var(--danger-text);
  --success: var(--success-text);
  --warning: var(--warning-text);
  --danger: var(--danger-text);

  --glass-blur: blur(28px) saturate(185%);
  --card-border: 1px solid transparent;
  --border-subtle: rgba(255, 255, 255, 0.1);
  --border-hover: rgba(255, 255, 255, 0.09);
  --divider-color: rgba(255, 255, 255, 0.1);
  --divider-subtle: 1px solid var(--divider-color);
  --table-border-subtle: 1px solid var(--divider-color);
  --card-shadow: 0 20px 48px -8px rgba(0, 0, 0, 0.65), 0 6px 18px rgba(0, 0, 0, 0.4);
  --card-rim: inset 0 1px 1px 0 rgba(255, 255, 255, 0.16);
  --focus-glow: 0 0 0 3px rgba(99, 102, 241, 0.25);
  --markdown-code-bg: rgba(18, 22, 30, 0.92);

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 14px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.65);

  --sidebar-bg: var(--bg-app);

  --scrollbar-thumb: rgba(255, 255, 255, 0.25);
  --scrollbar-thumb-hover: rgba(255, 255, 255, 0.45);
  --scrollbar-track: rgba(0, 0, 0, 0.15);

  --blob-1: radial-gradient(circle, rgba(14, 165, 233, 0.22) 0%, transparent 70%);
  --blob-2: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, transparent 70%);
  --blob-3: radial-gradient(circle, rgba(56, 189, 248, 0.14) 0%, transparent 70%);
  --blob-4: radial-gradient(circle, rgba(139, 92, 246, 0.16) 0%, transparent 70%);
}

/* ============================================================================
 * 2. 亮色模式 (LIGHT MODE) - 还原早期流体渐变与白晶磨砂
 * ============================================================================ */
html[data-theme="light"] {
  color-scheme: light;
  --chrome-ink: #151e32;
  --chrome-muted: #64748b;
  --chrome-hover: rgba(255, 255, 255, 0.65);
  --chrome-selected: rgba(255, 255, 255, 0.95);
  --bg-ambient: #f1f4f9;
  --bg-app: #f1f4f9;
  --context-navigation-bg: #e6edf7;
  --context-navigation-divider: rgba(210, 222, 238, 0.85);
  --topbar-bg: var(--bg-ambient);
  --bg-base: transparent;
  --bg-canvas: #f7f9fc;
  --page-header-bg: #f7f9fc;
  --page-pane-bg: #f7f9fc;
  --workspace-panel-bg: rgba(247, 249, 252, 0.94);
  --terminal-tabs-bg: rgba(244, 247, 254, 0.85);
  --terminal-surround-bg: rgba(244, 247, 254, 0.7);
  --session-tab-bg: rgba(255, 255, 255, 0.6);
  --session-tab-text: #4d5b76;
  --session-tab-hover-bg: rgba(255, 255, 255, 0.9);
  --session-tab-active-bg: #ffffff;
  --session-tab-active-hover-bg: #ffffff;
  --ambient-glow: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, rgba(99, 102, 241, 0.03) 30%, transparent 60%);
  --card-bg: rgba(255, 255, 255, 0.85);
  --bg-card: var(--card-bg);
  --bg-panel: rgba(255, 255, 255, 0.88);
  --bg-card-hover: var(--bg-card);
  --segmented-active-shadow: 0 2px 8px rgba(30, 41, 59, 0.08);
  --card-blur: 28px;
  --card-rim: inset 0 1px 1px 0 #ffffff;
  --bg-surface: #ffffff;
  --bg-muted: rgba(240, 245, 255, 0.7);
  --bg-hover: rgba(99, 102, 241, 0.06);
  --bg-selected: rgba(99, 102, 241, 0.12);
  --btn-primary-bg: #6366f1;
  --btn-primary-hover: #4f46e5;
  --btn-primary-text: #ffffff;
  --btn-confirm-bg: #6366f1;
  --btn-confirm-hover: #4f46e5;
  --btn-confirm-text: #ffffff;

  /* 下拉浮层面板专属 (亮色)：纯白高反差悬浮岛 + 双层高光 */
  --popover-bg: rgba(255, 255, 255, 0.98);
  --popover-border: 1px solid transparent;
  --popover-shadow: 0 20px 45px rgba(30, 41, 59, 0.12), 0 4px 16px rgba(30, 41, 59, 0.04), inset 0 1px 1px 0 #ffffff;
  --popover-item-hover: rgba(99, 102, 241, 0.06);
  --popover-item-active-bg: rgba(99, 102, 241, 0.12);
  --popover-item-active-text: #4f46e5;

  /* ── 表单控件 (亮色) ───────────────────────────────────────────────────
     内凹槽位 = 比所在表面深一档的冷灰，混的是 slate 蓝而不是文字色。

     为什么不是 `color-mix(surface, text-primary)`：文字色是近黑的暖蓝，
     混进表面后会得到一层发污的灰绿，和画布的 slate 冷调对不上；顶栏那种
     #edf2f9 的条上尤其明显。改用固定的 slate 色阶后，槽位始终是冷灰，
     和 --text-secondary / --border-subtle 同一族。

     四个状态构成一条单调阶梯，状态切换不会跳变：
       sunken (静息) < hover (更深) < focus (回落到表面白)
     focus 回落到表面白是有意的：控件"浮起来"接管输入，这才是焦点该有的
     抬升感；下拉选择器不走这条，它展开时保持 sunken（见 select.css）。 */
  --input-bg-sunken: #eef1f6;
  --input-bg-hover: #e7ebf2;
  --input-bg-focus: #ffffff;
  --input-bg: var(--input-bg-sunken);
  --input-surface-bg: #eef1f6;
  --input-surface-hover-bg: #e7ebf2;
  --input-surface-focus-bg: #ffffff;
  /* 对话输入区保留白色底，内部控件使用独立的 composer 配色。 */
  --composer-bg: #ffffff;
  --control-unchecked-bg: #cbd5e1;
  --control-checked-bg: #6366f1;
  --control-checked-mark: #ffffff;
  --switch-thumb-bg: #ffffff;
  --input-placeholder: var(--input-muted);
  /* Focus is ONE cue, not three stacked purples.
     Before: accent border + a 3px accent halo + the rim highlight all fired
     together, and because they share a hue the ring read as a thick lilac
     frame rather than a focus halo. Buttons mark focus with a single 2px
     outline, so the field now does the same: the border stays neutral and
     only the halo carries the accent. */
  --input-focus-border: color-mix(in srgb, var(--bg-surface) 82%, var(--text-tertiary));
  --input-focus-ring: 0 0 0 2px color-mix(in srgb, var(--accent-primary) 22%, transparent);
  /* 玻璃感与按钮同族：向外浮起，不是向内凹陷。
     - --input-lift    外投影，给控件一层脱离页面的高度
     - --input-rim     内高光，顶部一道亮边表达"玻璃厚度"
     - --input-border  近乎透明的细边，只在深色背景上兜住轮廓 */
  --input-border: 1px solid color-mix(in srgb, var(--bg-surface) 90%, var(--text-tertiary));
  --input-lift: 0 1px 2px rgba(15, 23, 42, 0.06), 0 2px 6px rgba(15, 23, 42, 0.04);
  --input-lift-hover: 0 2px 4px rgba(15, 23, 42, 0.08), 0 4px 10px rgba(15, 23, 42, 0.06);
  --input-rim: inset 0 1px 0 rgba(255, 255, 255, 0.9);
  /* --input-glass is the outward recipe used by form controls.
     --input-inner-shadow stays inset-only: switches, tables and list rows also
     consume it and must not be lifted off the page. */
  --input-glass: var(--input-lift), var(--input-rim);
  --input-inner-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05);

  /* 亮色终端不再用纯白底：纯白 + 浅灰 dim 文字是「太白、看着累」的主因，
     换成略深的纸灰底后眩光明显下降，同时仍与页面 --bg-canvas 分层。 */
  --terminal-canvas-bg: #f1f5f9;
  --terminal-foreground: #1f2937;
  --terminal-cursor: #1f2937;
  --terminal-selection: #cbd5e1;
  /* 亮色下 dim 只留 50% 会淡到接近不可见，单独调高保留强度。 */
  --terminal-dim-strength: 72%;
  --terminal-dim-ansi-strength: 94%;
  /* 亮色底浅，很多 TUI 的 truecolor / 256 色是按深底设计的，直接铺在浅底上会糊成一片。
     交给 xterm 动态把这类前景色调深到 WCAG AA，保留色相不改变应用本身的输出。 */
  --terminal-contrast-ratio: 4.5;
  /* ANSI colors are tuned for the paper canvas and stay above 5:1. */
  --terminal-black: #24292f;
  --terminal-red: #c81e28;
  --terminal-green: #0f5c24;
  --terminal-yellow: #734700;
  --terminal-blue: #0862ce;
  --terminal-magenta: #7b48d8;
  --terminal-cyan: #17727a;
  --terminal-white: #4a4a4a;
  --terminal-bright-black: #5a636f;
  --terminal-bright-red: #9c0c22;
  --terminal-bright-green: #17762f;
  --terminal-bright-yellow: #5c3700;
  --terminal-bright-blue: #0550ae;
  --terminal-bright-magenta: #6639ba;
  --terminal-bright-cyan: #096b72;
  --terminal-bright-white: #1d1d1f;
  --code-selection: #dedede;
  --code-find-match: #dcecff;
  --code-find-current: #9dcaff;
  --code-diff-added-bg: #eaf7ee;
  --code-diff-removed-bg: #fff0f0;
  --code-diff-added-text: #16834e;
  --code-diff-removed-text: #c23d48;
  --code-syntax-keyword: #a64b39;
  --code-syntax-literal: #bd6b23;
  --code-syntax-type: #2563a9;
  --code-syntax-string: #128a62;
  --code-syntax-attribute: #2563a9;
  --code-syntax-number: #bd6b23;
  --code-syntax-function: #2563a9;
  --code-syntax-builtin: #a85a1e;
  --code-syntax-meta: #a85a1e;
  --terminal-scrollbar-thumb: rgba(71, 85, 105, 0.42);
  --terminal-scrollbar-thumb-hover: rgba(51, 65, 85, 0.64);

  /* 按钮专属 (亮色) */
  --surface-action-bg: color-mix(in srgb, var(--bg-surface) 94%, var(--text-primary));
  --surface-action-hover-bg: color-mix(in srgb, var(--bg-surface) 89%, var(--text-primary));
  --surface-action-active-bg: color-mix(in srgb, var(--bg-surface) 84%, var(--text-primary));
  --button-hover-bg: var(--surface-action-hover-bg);
  --button-hover-text: #151e32;
  --rail-hover-bg: rgba(255, 255, 255, 0.7);
  --rail-active-bg: rgba(255, 255, 255, 0.95);
  --btn-secondary-bg: var(--bg-surface);
  --btn-secondary-hover: #f8fafc;
  --btn-secondary-border: rgba(203, 213, 225, 0.85);
  --btn-secondary-text: var(--text-primary);
  --btn-subtle-bg: transparent;
  --btn-subtle-hover: rgba(0, 0, 0, 0.05);
  --btn-subtle-border: transparent;
  --btn-subtle-text: var(--text-secondary);

  --segmented-active-bg: #ffffff;
  --segmented-active-hover-bg: #ffffff;
  --status-neutral-bg: var(--surface-inset-bg);

  /* 危险按钮核心：纯正鲜红实体 (#EF4444) + 纯白文字 */
  --btn-danger-default-bg: var(--status-danger-bg);
  --btn-danger-default-text: var(--status-danger-text);
  --btn-danger-default-border: transparent;
  --btn-danger-default-glow: 0 4px 14px rgba(239, 68, 68, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  --btn-danger-hover-bg: color-mix(in srgb, var(--danger-text) 12%, var(--bg-canvas));
  --btn-danger-hover-text: #ffffff;
  --btn-danger-hover-border: transparent;
  --btn-danger-hover-glow: 0 6px 20px rgba(239, 68, 68, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  --btn-danger-bg: var(--status-danger-bg);
  --btn-danger-hover: color-mix(in srgb, var(--danger-text) 12%, var(--bg-canvas));
  --btn-danger-text: var(--status-danger-text);

  /* 品牌核心主色：雾霾冷靛青 (Slate Indigo) */
  --accent-gradient: linear-gradient(135deg, #6366f1, #4f46e5);
  --accent-primary: #6366f1;
  --accent-hover: #4f46e5;
  --accent-glow: 0 4px 16px rgba(99, 102, 241, 0.35);
  --accent-subtle: rgba(99, 102, 241, 0.12);
  --accent-border: rgba(99, 102, 241, 0.25);
  --accent-text: #ffffff;

  --text-primary: #0f172a;
  --text-secondary: #475569;
  --text-tertiary: #64748b;
  --text-muted: #6b7a94;
  --text-quaternary: #9aa7be;
  --success-text: #059669;
  --warning-text: #d97706;
  --danger-text: #e11d48;

  --glass-blur: blur(28px) saturate(185%);
  --card-border: 1px solid transparent;
  --border-subtle: rgba(226, 232, 240, 0.9);
  --border-hover: rgba(255, 255, 255, 0.95);
  --divider-color: rgba(226, 234, 248, 0.8);
  --divider-subtle: 1px solid var(--divider-color);
  --table-border-subtle: 1px solid var(--divider-color);
  --card-shadow: 0 20px 44px -8px rgba(30, 41, 59, 0.1), 0 4px 16px rgba(30, 41, 59, 0.03);
  --card-rim: inset 0 1px 1px 0 #ffffff;
  --focus-glow: 0 0 0 3px rgba(99, 102, 241, 0.25);
  --markdown-code-bg: rgba(255, 255, 255, 0.95);

  --shadow-sm: 0 2px 6px rgba(30, 58, 110, 0.05);
  --shadow-md: 0 10px 28px -4px rgba(30, 58, 110, 0.07), inset 0 1px 1px 0 rgba(255, 255, 255, 0.95);
  --shadow-lg: 0 18px 45px -6px rgba(28, 54, 105, 0.14), inset 0 1px 1px 0 rgba(255, 255, 255, 0.95);

  --sidebar-bg: var(--context-navigation-bg);

  --scrollbar-thumb: rgba(30, 58, 110, 0.16);
  --scrollbar-thumb-hover: rgba(30, 58, 110, 0.3);
  --scrollbar-track: transparent;

  --blob-1: radial-gradient(circle, rgba(195, 217, 254, 0.75) 0%, transparent 70%);
  --blob-2: radial-gradient(circle, rgba(219, 234, 254, 0.65) 0%, transparent 70%);
  --blob-3: radial-gradient(circle, rgba(233, 213, 255, 0.5) 0%, transparent 70%);
  --blob-4: radial-gradient(circle, rgba(240, 253, 244, 0.55) 0%, transparent 70%);
}

/* Imported palettes own all shared chrome and surface tokens. */
html[data-custom-theme] {
  --workspace-panel-bg: var(--bg-canvas);
  --card-footer-bg: var(--bg-surface);
  --markdown-code-surface: var(--markdown-code-bg);
  --ambient-glow: radial-gradient(circle, color-mix(in srgb, var(--accent-primary) 8%, transparent) 0%, transparent 60%);
  --accent-glow: 0 4px 18px color-mix(in srgb, var(--accent-primary) 32%, transparent);
  --focus-glow: var(--input-focus-ring);
  /* 内凹槽位的描边按主题推导，自定义主题只改色不改这一层；写死 transparent 会让所有输入框失去凹陷边。 */
  --bg-ambient: var(--bg-app);
  --bg-base: var(--bg-canvas);
  --sidebar-bg: var(--context-navigation-bg);
  --topbar-bg: var(--bg-app);
  --bg-panel: var(--bg-canvas);
  --bg-muted: var(--bg-surface);
  --rail-hover-bg: var(--button-hover-bg);
  --rail-active-bg: var(--chrome-selected);
  --popover-item-hover: var(--bg-hover);
  --accent-gradient: linear-gradient(135deg, var(--btn-primary-bg), var(--btn-primary-hover));
  --accent-text: var(--btn-primary-text);
  --border-hover: var(--divider-color);
  --card-border: 1px solid transparent;
  --popover-border: 1px solid transparent;
  --btn-secondary-border: rgba(203, 213, 225, 0.85);
  --btn-subtle-border: transparent;
  --terminal-scrollbar-thumb: var(--scrollbar-thumb);
  --terminal-scrollbar-thumb-hover: var(--scrollbar-thumb-hover);
  --scrollbar-track: transparent;
}

/* ==========================================================================
   Glass button material: one shared recipe for every labelled button.
   Icon-only buttons opt out and keep their flat quiet resting state.
   ========================================================================== */
html[data-theme] {
  --btn-glass-blur: blur(20px) saturate(170%);
  --btn-glass-rim: inset 0 1px 0 rgba(255, 255, 255, 0.32), inset 0 -1px 0 rgba(255, 255, 255, 0.06);
  --btn-glass-sheen: linear-gradient(160deg, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0) 46%);

  /* Glass fills: the tint carries the semantic, the density carries the
     thickness, the sheen and rim carry the material. Depth comes from fill
     density, never from a coloured outer glow, so a tinted button reads as a
     slab of glass rather than a lamp. The lift is a neutral contact shadow
     only: it separates the slab from the page, it does not glow. */
  --btn-glass-lift: 0 1px 2px rgba(0, 0, 0, 0.30);
  --btn-glass-lift-hover: 0 2px 5px rgba(0, 0, 0, 0.34);
  --btn-glass-accent-bg: color-mix(in srgb, var(--accent-primary) 26%, transparent);
  --btn-glass-accent-hover: color-mix(in srgb, var(--accent-primary) 36%, transparent);
  --btn-glass-accent-active: color-mix(in srgb, var(--accent-primary) 44%, transparent);
  --btn-glass-accent-text: color-mix(in srgb, var(--accent-primary) 72%, var(--text-primary));
  --btn-glass-neutral-bg: rgba(255, 255, 255, 0.10);
  --btn-glass-neutral-hover: rgba(255, 255, 255, 0.18);
  --btn-glass-neutral-active: rgba(255, 255, 255, 0.24);
  --btn-glass-danger-bg: color-mix(in srgb, var(--danger-text) 32%, transparent);
  --btn-glass-danger-hover: color-mix(in srgb, var(--danger-text) 42%, transparent);
  --btn-glass-danger-active: color-mix(in srgb, var(--danger-text) 50%, transparent);
}

html[data-theme="light"] {
  --btn-glass-rim: inset 0 1px 0 rgba(255, 255, 255, 0.92), inset 0 -1px 0 rgba(255, 255, 255, 0.35);
  --btn-glass-sheen: linear-gradient(160deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 52%);

  /* Daylight glass: a white slab on a near-white canvas needs a shallower tint
     plus a slate contact shadow, otherwise the fill either washes out or the
     lift turns into a grey smudge. */
  --btn-glass-lift: 0 1px 2px rgba(15, 23, 42, 0.10);
  --btn-glass-lift-hover: 0 2px 5px rgba(15, 23, 42, 0.14);
  --btn-glass-accent-bg: color-mix(in srgb, var(--accent-primary) 14%, transparent);
  --btn-glass-accent-hover: color-mix(in srgb, var(--accent-primary) 22%, transparent);
  --btn-glass-accent-active: color-mix(in srgb, var(--accent-primary) 30%, transparent);
  --btn-glass-neutral-bg: rgba(15, 23, 42, 0.06);
  --btn-glass-neutral-hover: rgba(15, 23, 42, 0.10);
  --btn-glass-neutral-active: rgba(15, 23, 42, 0.14);
  --btn-glass-danger-bg: color-mix(in srgb, var(--danger-text) 14%, transparent);
  --btn-glass-danger-hover: color-mix(in srgb, var(--danger-text) 22%, transparent);
  --btn-glass-danger-active: color-mix(in srgb, var(--danger-text) 30%, transparent);
}

html[data-theme="dark"] {
}

/* Stacked card nesting: every level inside another card sinks one step. */
html[data-theme] {
  --status-pending-border: 1.5px solid rgba(255, 255, 255, 0.32);
}

html[data-theme="light"] {
  --status-pending-border: 1.5px solid rgba(15, 23, 42, 0.35);
}


/* ---- ./typography.css ---- */
/**
 * ============================================================================
 * Android Toolkit 字体系统规范 (Typography System)
 * 可切换界面字体 + JetBrains Mono 等宽代码字体
 * ============================================================================
 */

body {
  font-family: var(--font-sans);
  font-size: 13px;
  line-height: 1.5;
  font-weight: 400;
  letter-spacing: 0;
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
}

/* 标题规范 */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  font-weight: 600;
  letter-spacing: 0;
  color: var(--text-primary);
}

/* 等宽数值与代码规范 (开启数字等宽对齐，防止跳动) */
code, kbd, samp, pre, .text-mono {
  font-family: var(--font-mono);
  font-feature-settings: "tnum" 1;
  font-variant-numeric: tabular-nums;
}

.tabular-nums {
  font-variant-numeric: tabular-nums;
}

/* 常用文本颜色辅助类 */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-accent { color: var(--accent-primary); }
.text-success { color: var(--status-success-text); }
.text-danger { color: var(--status-danger-text); }


/* ---- ./ambient.css ---- */
/**
 * ============================================================================
 * Android Toolkit 全局背景：浅冷灰 / 石墨灰。
 * 输入框的动态炫光独立保留在 BorderGlow 中。
 * ============================================================================
 */

.ambient-wallpaper,
.ambient-wrapper {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: var(--bg-app);
  transition: background var(--transition-base);
}

.ambient-blob {
  display: none;
  position: absolute;
  border-radius: 50%;
  filter: blur(80px); /* 从 100px 降低到 80px 以优化性能 */
  will-change: transform;
  transition: background 0.5s ease;
}

/* Showcase uses a clean base; ambient light stays inside the glass cards. */
html[data-theme="light"] .ambient-wallpaper,
html[data-theme="light"] .ambient-wrapper {
  background: var(--bg-ambient);
}

html[data-theme="light"] .ambient-blob {
  display: none;
  mix-blend-mode: normal;
  opacity: 0.65;
}

/* 暗色模式下：采用 screen 柔和深邃漫射，不刺眼 */
html[data-theme="dark"] .ambient-blob {
  mix-blend-mode: screen;
  opacity: 0.35;
}

/* 形状 1: 冰蓝光斑 (Soft blue) */
.ambient-blob.blob-1 {
  top: -10%;
  left: -10%;
  width: 520px;
  height: 520px;
  background: var(--blob-1);
  animation: float-blob-1 20s infinite alternate ease-in-out;
}

/* 形状 2: 天蓝光斑 (Sky blue) */
.ambient-blob.blob-2 {
  bottom: -15%;
  right: 15%;
  width: 560px;
  height: 560px;
  background: var(--blob-2);
  animation: float-blob-2 25s infinite alternate-reverse ease-in-out;
}

/* 形状 3: 深蓝弥散 (Deep blue) */
.ambient-blob.blob-3 {
  top: 20%;
  right: -10%;
  width: 440px;
  height: 440px;
  background: var(--blob-3);
  animation: float-blob-3 20s infinite alternate ease-in-out;
}

/* 形状 4: 淡薰衣草紫/温暖流体 (Subtle Lavender) */
.ambient-blob.blob-4 {
  bottom: 10%;
  left: 20%;
  width: 480px;
  height: 480px;
  background: var(--blob-4);
  animation: float-blob-4 22s infinite alternate-reverse ease-in-out;
}

@keyframes float-blob-1 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(40px, 30px) scale(1.08); }
}

@keyframes float-blob-2 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(-35px, -25px) scale(1.1); }
}

@keyframes float-blob-3 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(-25px, 35px) scale(0.95); }
}

@keyframes float-blob-4 {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(30px, -20px) scale(1.05); }
}

/* 2. 原子控件 —— 这些 tsx 不含 css import，样式必须在这里按顺序进来 */

/* ---- ../../components/Divider/divider.css ---- */
/**
 * ============================================================================
 * Divider 结构分割线组件规范
 * 满足“如果某个界面里是左右结构，上下结构 每个结构之间要加很虚的分割线”
 * ============================================================================
 */

/* 水平微弱分割线 (上下结构之间) */
.divider-h {
  width: 100%;
  height: 0;
  border: 0;
  border-radius: 0 !important;
  border-bottom: var(--divider-subtle);
  margin: 16px 0;
}

.divider-h.dense {
  margin: 8px 0;
}

.divider-h.dashed {
  border-bottom: var(--divider-dashed);
}

/* 垂直微弱分割线 (左右结构之间) */
.divider-v {
  width: 0;
  height: auto;
  align-self: stretch;
  border: 0;
  border-radius: 0 !important;
  border-right: var(--divider-subtle);
  margin: 0 16px;
}

.divider-v.dense {
  margin: 0 8px;
}

.divider-v.dashed {
  border-right: var(--divider-dashed);
}

/* 结构容器辅助：左右分栏之间自带极虚边线 */
.split-left-pane {
  border-radius: 0 !important;
  border-right: var(--divider-subtle);
}

.split-right-pane {
  border-radius: 0 !important;
  border-left: var(--divider-subtle);
}

/* 结构容器辅助：上下分区自带极虚边线 */
.split-top-bar {
  border-radius: 0 !important;
  border-bottom: var(--divider-subtle);
}

.split-bottom-bar {
  border-radius: 0 !important;
  border-top: var(--divider-subtle);
}

/* Separators stay square in every consumer, including draggable pane handles. */
[role="separator"],
[role="separator"]::before,
[role="separator"]::after,
.conversation-rail-dot,
.code-viewer-pane-resizer::before,
.code-viewer-pane-resizer::after,
.ui-preview-header,
.ui-preview-modes,
.ui-preview-search,
.ui-usage,
.divider-h,
.divider-v,
.split-left-pane,
.split-right-pane,
.split-top-bar,
.split-bottom-bar {
  border-radius: 0 !important;
}


/* ---- ../../components/Button/button.css ---- */
/* ==========================================================================
   Button Component Styles - 按钮组件规范
   - 物理底座手感、鲜红危险态、平滑加载态与微回弹动效
   ========================================================================== */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-family: var(--font-sans);
  font-weight: 500;
  border-radius: var(--radius-base);
  border: 1px solid transparent;
  cursor: pointer;
  user-select: none;
  outline: none;
  white-space: nowrap;
  transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  box-sizing: border-box;
}

.btn:active:not(:disabled) {
  transform: translateY(1px);
}

.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* Line icon actions share the same quiet resting state across pages. */
.btn.btn-icon-only { aspect-ratio: 1; padding-inline: 0; }
html[data-theme] .btn.btn-subtle.btn-icon-only {
  background: transparent;
  color: var(--text-secondary);
  box-shadow: none;
}
html[data-theme] .btn.btn-subtle.btn-icon-only:hover:not(:disabled) {
  background: var(--button-hover-bg);
  color: var(--button-hover-text);
  box-shadow: none;
}
.btn-icon-only .btn-icon { display: inline-flex; align-items: center; justify-content: center; }
.btn-icon-only svg { stroke-width: 1.6; }

/* 尺寸变体 */
.btn-xs {
  height: 24px;
  padding: 0 8px;
  font-size: 11.5px;
}

.btn-sm {
  height: 28px;
  padding: 0 12px;
  font-size: 12px;
}

.btn-md {
  height: 32px;
  padding: 0 14px;
  font-size: 13px;
}

.btn-lg {
  height: 38px;
  padding: 0 18px;
  font-size: 14px;
}

/* Glass material for every labelled button. Icon-only actions opt out so
   toolbars do not fill up with frosted squares around every glyph. */
html[data-theme] .btn:not(.btn-icon-only):not(.btn-bare) {
  position: relative;
  backdrop-filter: var(--btn-glass-blur);
  -webkit-backdrop-filter: var(--btn-glass-blur);
}

html[data-theme] .btn:not(.btn-icon-only):not(.btn-primary):not(.btn-bare)::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: var(--btn-glass-sheen);
  pointer-events: none;
}

html[data-theme] .btn:not(.btn-icon-only) > * {
  position: relative;
  z-index: 1;
}

/* 样式变体 */
/* Primary glow: tighter than --accent-glow on purpose. The shared token is
   also used by the task-step dot, where the wider spread is correct; on a
   button it reads as a coloured halo, so the button gets its own lift. */
.btn-primary {
  --btn-primary-glow: 0 2px 8px color-mix(in srgb, var(--accent-primary) 22%, transparent);
  background: var(--btn-primary-bg);
  color: var(--btn-primary-text);
  border-color: transparent;
  box-shadow: var(--btn-primary-glow), var(--btn-primary-rim);
  font-weight: 550;
}

.btn-primary:hover:not(:disabled) {
  background: var(--btn-primary-hover);
  box-shadow: var(--btn-primary-glow), var(--btn-primary-rim);
}

.btn-secondary {
  background: var(--btn-glass-accent-bg);
  color: var(--btn-glass-accent-text);
  border-color: transparent;
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

.btn-secondary:hover:not(:disabled) {
  background: var(--btn-glass-accent-hover);
  color: var(--btn-glass-accent-text);
  box-shadow: var(--btn-glass-lift-hover), var(--btn-glass-rim);
}

.btn-secondary:active:not(:disabled) {
  background: var(--btn-glass-accent-active);
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

.btn-secondary.is-active,
.btn-secondary.active {
  background: var(--bg-selected) !important;
  color: var(--accent-primary) !important;
  border-color: transparent !important;
}

.btn-primary:focus-visible {
  background: var(--btn-primary-hover);
  color: var(--btn-primary-text);
}

.btn.btn-danger-hover:hover:not(:disabled) {
  color: var(--btn-danger-text) !important;
  background: var(--btn-glass-danger-bg) !important;
  border-color: transparent !important;
}

.btn.btn-danger-hover:active:not(:disabled) {
  color: var(--btn-danger-text) !important;
  background: var(--btn-glass-danger-active) !important;
}

.btn-subtle {
  background: var(--btn-glass-neutral-bg);
  color: var(--btn-subtle-text);
  border-color: transparent;
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

.btn-subtle:hover:not(:disabled) {
  background: var(--btn-glass-neutral-hover);
  color: var(--text-primary);
  box-shadow: var(--btn-glass-lift-hover), var(--btn-glass-rim);
}

.btn-subtle:active:not(:disabled) {
  background: var(--btn-glass-neutral-active);
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

.btn-danger {
  background: var(--btn-glass-danger-bg);
  color: var(--btn-danger-text) !important;
  border: 1px solid transparent;
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

.btn-danger:hover:not(:disabled) {
  background: var(--btn-glass-danger-hover) !important;
  color: var(--btn-danger-text) !important;
  box-shadow: var(--btn-glass-lift-hover), var(--btn-glass-rim);
}

.btn-danger:active:not(:disabled) {
  background: var(--btn-glass-danger-active) !important;
  color: var(--btn-danger-text) !important;
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

.btn-success {
  background: var(--btn-success-bg);
  color: var(--btn-success-text);
  box-shadow: var(--btn-glass-rim);
}

.btn-success:hover:not(:disabled) {
  background: var(--btn-success-hover);
}

/* Neutral surface actions share their resting, hover and selected skin. */
html[data-theme] .btn.btn-surface {
  background: var(--btn-glass-neutral-bg);
  color: var(--control-text);
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

html[data-theme] .btn.btn-surface:hover:not(:disabled) {
  background: var(--btn-glass-neutral-hover);
  color: var(--text-primary);
  box-shadow: var(--btn-glass-lift-hover), var(--btn-glass-rim);
}

html[data-theme] .btn.btn-surface:is(.active, .is-active, [aria-pressed="true"]):not(:disabled),
html[data-theme] .btn.btn-surface:active:not(:disabled) {
  background: var(--btn-glass-neutral-active);
  color: var(--text-primary);
  box-shadow: var(--btn-glass-lift), var(--btn-glass-rim);
}

html[data-theme] .btn.btn-surface:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 2px;
}

/* 加载态 Spinner */
.btn-loading {
  position: relative;
  pointer-events: none;
}

.btn-spinner {
  width: 13px;
  height: 13px;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-radius: 50%;
  animation: btnSpin 0.7s linear infinite;
  display: inline-block;
  flex-shrink: 0;
}

@keyframes btnSpin {
  to {
    transform: rotate(360deg);
  }
}
/* ==========================================================================
   btn-bare — no box of its own.
   Used where the clickable surface is defined by the parent: a list row, the
   round context-usage ring, a toast action. Only decoration is cleared —
   fill, shadow, glass, border paint. Geometry (size, padding, radius) stays
   the host's business.
   ========================================================================== */
.btn.btn-bare {
  /* 只清除 .btn 注入的外观，几何留给宿主。
     注意：这里不能写 border-radius: 0 —— 那会把宿主自己声明的圆角
     一并压平（环形的 hover 就是因此变成方块的）。 */
  border-color: transparent;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  font: inherit;
  font-weight: inherit;
  color: inherit;
  text-align: inherit;
  cursor: pointer;
}

.btn.btn-bare:active:not(:disabled) { transform: none; }

.btn.btn-bare:disabled { opacity: 0.45; cursor: not-allowed; }

.btn.btn-bare:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 2px;
}


/* ---- ../../components/Button/tool-back-button.css ---- */
.btn.tool-page-back-button {
  width: 32px;
  min-width: 32px;
  height: 28px;
  padding: 0;
  flex: 0 0 auto;
}

.tool-page-back-button .btn-icon {
  display: inline-flex;
}


/* ---- ../../components/Input/input.css ---- */
/* ==========================================================================
   Input Component Styles - 输入框组件规范
   - 100% 还原 modern-ui-showcase.html 沉浸内凹槽位 (Sunken Slot)
   - 消除生硬外框线，支持前缀图标与一键清除/复合操作组
   - 支持 .desk-input / .input 以及 .input-shell / .input-wrapper 双别名
   ========================================================================== */

.input-shell,
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.desk-input,
.input {
  width: 100%;
  height: var(--control-height);
  padding: 0 12px;
  background: var(--input-bg-sunken);
  color: var(--input-text);
  border: var(--input-border);
  border-radius: var(--control-radius);
  font-family: var(--font-sans);
  font-size: 12.5px;
  outline: none;
  /* Same glass family as the buttons: lift outward with a soft drop shadow,
     plus an inner rim highlight so the top edge reads as a glass thickness.
     Nothing is inset — the control sits on the surface, not in it. */
  box-shadow: var(--input-glass);
  backdrop-filter: blur(14px);
  transition: background-color var(--transition-fast), color var(--transition-fast),
    border-color var(--transition-fast), box-shadow var(--transition-fast);
  box-sizing: border-box;
}

.desk-input::placeholder,
.input::placeholder {
  color: var(--input-placeholder);
  opacity: 1;
}

/* Hover raises the control one step. It does NOT touch the border: dropping it
   to `transparent` made the field visibly lose its edge on hover, which read
   as a colour change rather than a lift. Same hairline, higher shadow. */
.desk-input:hover:not(:disabled):not(:focus),
.input:hover:not(:disabled):not(:focus) {
  background: var(--input-bg-hover);
  color: var(--input-hover-text);
  box-shadow: var(--input-lift-hover), var(--input-glass);
}

/* Focus lifts the field to the page surface and draws one accent halo.
   Same accent family as button focus rings, one step softer. */
/* Focus keeps the lift and adds the accent halo on top of it, so the control
   rises rather than sinking. */
.desk-input:focus,
.input:focus {
  background: var(--input-bg-focus);
  color: var(--input-hover-text);
  border-color: var(--input-focus-border);
  box-shadow: var(--input-focus-ring), var(--input-glass);
}

.desk-input:disabled,
.input:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.desk-input[readonly],
.input[readonly] { color: var(--text-secondary); }

/* Surface variant (topbar search and other flat search fields).
   It used to carry `box-shadow: none`, which flattened it into the bar and is
   why the topbar search looked like it had missed the form-control pass
   entirely. It now wears the same glass as every other field: same fill, same
   lift, same rim. Only the radius is tighter, because it lives in a 28px bar. */
.input-surface .input {
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  background: var(--input-surface-bg);
  box-shadow: var(--input-glass);
}
.input-surface .input::placeholder { color: var(--text-tertiary); }
.input-surface .input-prefix-icon { color: var(--text-secondary); }
.input-surface .input:hover:not(:disabled):not(:focus) {
  color: var(--text-primary);
  background: var(--input-surface-hover-bg, var(--input-surface-bg));
  box-shadow: var(--input-lift-hover), var(--input-glass);
}
.input-surface .input:focus {
  color: var(--text-primary);
  background: var(--input-surface-focus-bg, var(--input-surface-bg));
  box-shadow: var(--input-focus-ring), var(--input-glass);
}

/* 尺寸变体 */
.input-sm {
  height: var(--control-height-sm);
  padding: 0 10px;
  font-size: 12px;
}

.input-md {
  height: var(--control-height-md);
  padding: 0 12px;
  font-size: 12.5px;
}

.input-lg {
  height: var(--control-height-lg);
  padding: 0 14px;
  font-size: 13.5px;
}

/* 前置图标 */
.has-lead .desk-input,
.has-lead .input,
.input-with-icon-prefix .desk-input,
.input-with-icon-prefix .input {
  padding-left: 36px !important;
}

.has-tail .desk-input,
.has-tail .input,
.input-with-action .desk-input,
.input-with-action .input {
  padding-right: 36px !important;
}

.input-lead-icon,
.input-prefix-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  width: 15px;
  height: 15px;
  color: var(--input-muted);
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: color 0.18s;
}

/* 一键清除胶囊 */
/* Clear affordance: same treatment as the toast × and the attachment remove
   button — nothing at rest, a quiet tint on hover.

   The button is a library `Button variant="bare"`, which carries
   `.btn.btn-bare` (0,2,0). A plain `.input-clear-pill` selector (0,1,0) loses
   to it, which is why the fill and radius used to disappear. The selector is
   qualified with `.btn` so this rule actually lands. */
.input-clear-pill.btn,
.input-clear-pill {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  min-width: 20px;
  height: 20px;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  color: var(--input-muted);
  cursor: pointer;
  z-index: 10;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.input-clear-pill.btn:hover:not(:disabled),
.input-clear-pill:hover {
  color: var(--text-primary);
  background: var(--chrome-hover);
}

.input-clear-pill.btn:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 1px;
}


/* ---- ../../components/Select/select.css ---- */
/* ==========================================================================
   Select Component Styles - 下拉选择器规范
   - 100% 还原 modern-ui-showcase.html 原生高阶悬浮板 (High Elevation Popover)
   - 彻底解决横向滚动条 Bug + 半透明实心阻隔
   - 支持 .modern-select / .select-pod 以及 .select-trigger / .select-trigger-bar 双别名
   ========================================================================== */

.modern-select,
.select-pod {
  position: relative;
  width: 100%;
}

/* The trigger is the same recessed slot as a text input: identical fill,
   identical hairline, identical inner shadow. A select and an input sitting
   side by side must be indistinguishable at rest. */
.select-trigger,
.select-trigger-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: var(--control-height);
  padding: 0 11px 0 13px;
  background: var(--input-bg-sunken);
  color: var(--input-text);
  border: var(--input-border);
  border-radius: var(--control-radius);
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  user-select: none;
  outline: none;
  box-shadow: var(--input-glass);
  backdrop-filter: blur(14px);
  transition: background-color var(--transition-fast), color var(--transition-fast),
    border-color var(--transition-fast), box-shadow var(--transition-fast);
  box-sizing: border-box;
}

.select-trigger:hover:not(:disabled),
.select-trigger-bar:hover:not(:disabled) {
  background: var(--input-bg-hover);
  color: var(--input-hover-text);
  box-shadow: var(--input-lift-hover), var(--input-glass);
}

/* Opening the menu does not repaint the field.
   A text input lifts to the page surface on focus because you are about to
   type into it. A select is different: the trigger stays anchored exactly
   where it was while the menu floats above it, so the fill and the hairline
   hold still and only the accent halo marks the open state. Without this the
   trigger jumped to `--input-bg-focus` (pure white in light mode) the moment
   it was clicked. */
.modern-select.is-open .select-trigger,
.select-pod.is-open .select-trigger-bar {
  background: var(--input-bg-sunken);
  color: var(--input-hover-text);
  border-color: var(--input-focus-border);
  box-shadow: var(--input-focus-ring), var(--input-glass);
}

/* Keyboard focus on a closed trigger uses the same halo. */
.select-trigger:focus-visible {
  background: var(--input-bg-sunken);
  color: var(--input-hover-text);
  border-color: var(--input-focus-border);
  box-shadow: var(--input-focus-ring), var(--input-glass);
}

.select-value-text,
.select-echo-box {
  display: flex;
  align-items: center;
  gap: 9px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  text-align: left;
}

.select-arrow,
.select-chevron-icon {
  width: 14px;
  height: 14px;
  color: var(--input-muted);
  transition: transform 0.2s var(--ease-spring), color 0.2s;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modern-select.is-open .select-arrow,
.select-pod.is-open .select-chevron-icon {
  transform: rotate(180deg);
  color: var(--input-text);
}

/* 弹出菜单面板 (POPOVER) - 核心重点：高阶实心浮空板，彻底告别与卡片重合！ */
.select-dropdown,
.select-glass-menu {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  z-index: 999999;
  background: var(--popover-bg);
  border: var(--popover-border);
  border-radius: 14px;
  box-shadow: var(--popover-shadow);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  padding: 6px;
  display: none;
  overflow-x: hidden;
  animation: popoverFadeIn 0.16s var(--ease-spring);
  box-sizing: border-box;
}

.select-dropdown.is-portaled {
  position: fixed !important;
  z-index: 999999 !important;
  max-height: calc(100dvh - 16px);
}

@keyframes popoverFadeIn {
  from { opacity: 0; transform: translateY(-4px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.modern-select.is-open .select-dropdown,
.select-pod.is-open .select-glass-menu,
.select-dropdown.is-portaled {
  display: block;
}

.select-options-list,
.menu-options-list {
  display: flex;
  flex-direction: column;
  gap: 3px;
  max-height: min(240px, var(--select-list-max-height, 240px));
  overflow-y: auto;
  scrollbar-gutter: stable;
  overflow-x: hidden; /* 杜绝横向滚动条 */
}

.select-search {
  padding: 2px 2px 8px;
}

.select-search .input-shell {
  width: 100%;
}

.select-search-empty {
  padding: 12px;
  font-size: 12px;
  color: var(--text-tertiary);
}

.select-option:focus-visible {
  background: var(--popover-item-hover);
}

/* 选项条目 */
.select-option,
.select-item-pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 34px;
  height: auto;
  padding: 7px 12px;
  gap: 10px;
  background: transparent;
  color: var(--text-primary);
  border: 0;
  border-radius: calc(var(--control-radius) - 2px);
  font-size: 12.5px;
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
  text-align: left;
  user-select: none;
  box-sizing: border-box;
}

.select-option-text {
  flex: 1;
  text-align: left;
  white-space: normal;
  overflow: visible;
  word-break: break-word;
  line-height: 1.35;
}

.select-option-row { display: flex; align-items: center; gap: 4px; border-radius: 9px; }
/* 悬停高亮落在整行：右侧删除按钮与选项共享同一块底色，不再各占一半 */
.select-option-row:hover,
.select-option-row:focus-within { background: var(--popover-item-hover); }
.select-option-row:hover > .select-option,
.select-option-row:focus-within > .select-option { background: transparent; color: var(--text-primary); }
.select-option-row:hover > .select-option.selected,
.select-option-row:hover > .select-option.is-active,
.select-option-row:focus-within > .select-option.selected,
.select-option-row:focus-within > .select-option.is-active { background: var(--popover-item-active-bg) !important; }
.select-option-row:hover > .select-option-remove { color: var(--text-secondary); }
.select-group-label { padding: 9px 12px 3px; color: var(--text-secondary); font-size: 11px; font-weight: 600; }
.select-option-row.is-grouped { padding-left: 10px; }
.select-option-row > .select-option { flex: 1; min-width: 0; }
.select-option-remove { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 26px; height: 26px; margin-right: 4px; padding: 0; border: 0; border-radius: var(--radius-sm); color: var(--text-secondary); background: transparent; cursor: pointer; }
.select-option-remove:hover, .select-option-remove:focus-visible { color: var(--danger-text); background: transparent; }

.select-option:hover,
.select-item-pill:hover {
  background: var(--popover-item-hover);
  color: var(--text-primary);
}
/* row 内部的选项不再单独铺底色，避免和整行高亮叠成两块 */
.select-option-row > .select-option:hover,
.select-option-row > .select-item-pill:hover {
  background: transparent;
}
.select-option-row > .select-option.selected:hover,
.select-option-row > .select-option.is-active:hover,
.select-option-row > .select-item-pill.is-active:hover {
  background: var(--popover-item-active-bg) !important;
}

/* 选中项：采用高亮强调色药丸底板，字色高反白，极其醒目！ */
.select-option.selected,
.select-option.is-active,
.select-item-pill.is-active {
  background: var(--popover-item-active-bg) !important;
  color: var(--popover-item-active-text) !important;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

html[data-theme] :is(.select-arrow, .select-chevron-icon) {
  color: var(--control-text);
}

html[data-theme] :is(.modern-select.is-open .select-arrow, .select-pod.is-open .select-chevron-icon) {
  color: var(--text-primary);
}

html[data-theme] .select-option.selected svg {
  color: inherit !important;
}

/* ==========================================================================
   Select option extensions: description rows, trailing actions, nested menus
   ========================================================================== */
.select-option-copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1 1 auto; }
.select-option-copy .select-option-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.select-option-description { overflow: hidden; color: var(--text-tertiary); font-size: 10.5px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }

.select-option.has-description { align-items: flex-start; min-height: 44px; padding-top: 7px; padding-bottom: 7px; }
/* 右侧紧凑徽标：让选项保持单行，不再为了上下文另起一行 */
/* 右侧紧凑徽标：--chrome-hover 在浅色下接近纯白，会和弹层底色糊在一起，
   这里改用实底 + 内描边，保证任何主题下都能看清胶囊轮廓 */
.select-option-trailing { flex: 0 0 auto; padding: 1px 7px; border-radius: 6px; background: var(--input-bg-sunken, var(--bg-card)); box-shadow: inset 0 0 0 1px var(--divider-color); color: var(--text-secondary); font-size: 10.5px; font-weight: 500; line-height: 15px; white-space: nowrap; }
.select-option.selected .select-option-trailing,
.select-option.is-active .select-option-trailing { background: color-mix(in srgb, currentColor 14%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 24%, transparent); color: inherit; }
.select-option.is-disabled { opacity: 0.45; cursor: not-allowed; }

.select-option-action,
.select-option-expand { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 26px; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 7px; background: transparent; color: var(--text-tertiary); cursor: pointer; transition: color var(--transition-fast), background-color var(--transition-fast); }
.select-option-action:hover,
.select-option-expand:hover { color: var(--text-primary); background: var(--chrome-hover); }
.select-option-action.is-danger:hover { color: var(--status-danger-text); background: var(--status-danger-bg); }
.select-option-expand svg { transition: transform var(--transition-fast); }
.select-option-expand.is-open svg { transform: rotate(180deg); }

.select-option-row.is-submenu-open { background: var(--chrome-hover); border-radius: 9px; }

/* Nested panel anchored under the row, so a menu can host a second level. */
.select-submenu { margin: 4px 6px 8px 14px; padding: 8px; border: var(--popover-border); border-radius: 10px; background: var(--popover-bg); box-shadow: var(--popover-shadow); animation: select-submenu-in var(--transition-fast) both; }
@keyframes select-submenu-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .select-submenu { animation: none; } }

.select-menu-header { padding: 8px 10px 6px; color: var(--text-tertiary); font-size: 10.5px; font-weight: 700; }
.select-menu-footer { margin-top: 4px; padding: 8px 10px 4px; border-top: 1px solid var(--divider-color); }


/* ---- ../../components/Switch/switch.css ---- */
/* ==========================================================================
   Switch & Checkbox & Segmented Component Styles
   - 100% 还原 modern-ui-showcase.html 微回弹物理手感
   ========================================================================== */

/* 微回弹 Switch 开关 */
.switch-wrapper {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  cursor: pointer;
  user-select: none;
}

.switch-wrapper .switch,
.desk-toggle {
  position: relative;
  display: inline-flex;
  align-items: center;
  width: 38px;
  height: 22px;
  flex-shrink: 0;
  cursor: pointer;
  user-select: none;
}

.switch-label {
  color: var(--text-primary);
  white-space: nowrap;
}

.switch-wrapper input,
.desk-toggle input {
  opacity: 0;
  width: 0;
  height: 0;
  position: absolute;
}

.switch-slider,
.toggle-track {
  position: absolute;
  inset: 0;
  background: var(--control-unchecked-bg);
  border: 1px solid transparent;
  border-radius: 999px;
  transition: all 0.22s var(--ease-spring);
  box-shadow: var(--input-inner-shadow);
}

.switch-slider::before,
.toggle-thumb {
  content: "";
  position: absolute;
  top: 2px;
  left: 2px;
  width: 16px;
  height: 16px;
  background: #ffffff !important;
  border-radius: 50%;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  transition: transform 0.22s var(--ease-bounce);
}

.switch-wrapper input:checked + .switch-slider,
.desk-toggle input:checked + .toggle-track {
  background: var(--accent-primary) !important;
  border-color: transparent !important;
  box-shadow: 0 2px 14px rgba(99, 102, 241, 0.45) !important;
}

.switch-wrapper input:checked + .switch-slider::before,
.desk-toggle input:checked + .toggle-track .toggle-thumb {
  transform: translateX(16px);
}

.switch-wrapper input:focus-visible + .switch-slider,
.desk-toggle input:focus-visible + .toggle-track {
  box-shadow: var(--focus-ring);
}

/* 禁用态 */
.switch-wrapper.is-disabled,
.desk-toggle.is-disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

/* Checkbox 复选框 */
.checkbox-row {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  cursor: pointer;
  user-select: none;
  font-size: 12.5px;
  color: var(--text-primary);
}

.checkbox,
.desk-chk {
  position: relative;
  width: 16px;
  height: 16px;
  appearance: none;
  -webkit-appearance: none;
  background: var(--control-unchecked-bg);
  border: 1px solid transparent;
  border-radius: 5px;
  outline: none;
  cursor: pointer;
  transition: all 0.18s;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  box-shadow: var(--input-inner-shadow);
}

.checkbox:checked,
.desk-chk:checked,
.checkbox:indeterminate,
.desk-chk:indeterminate {
  background: var(--control-checked-bg);
  border-color: transparent;
  box-shadow: none;
}

.checkbox:checked::after,
.desk-chk:checked::after {
  content: "";
  width: 4px;
  height: 8px;
  border: solid var(--control-checked-mark);
  border-width: 0 2px 2px 0;
  transform: rotate(45deg) translate(-0.5px, -1px);
}

.checkbox:indeterminate::after,
.desk-chk:indeterminate::after {
  content: "";
  width: 8px;
  height: 2px;
  background: var(--control-checked-mark);
}

.checkbox:focus-visible,
.desk-chk:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }
.checkbox:disabled,
.desk-chk:disabled { cursor: not-allowed; opacity: .55; }

/* 分段视图控制器 (Segmented) */
.segmented-glass {
  display: inline-flex;
  align-items: center;
  background: var(--segmented-bg);
  border: 0;
  border-radius: var(--control-radius);
  padding: 2px;
  gap: 2px;
}

.segmented-glass .seg-btn {
  padding: 4px 12px;
  height: calc(var(--control-height) - 6px);
  font-size: 11.5px;
  font-weight: 600;
  color: var(--segmented-text);
  background: transparent;
  border: 0;
  border-radius: calc(var(--control-radius) - 2px);
  cursor: pointer;
  transition: all 0.18s;
  user-select: none;
}

.segmented-glass .seg-btn:hover:not(:disabled) {
  background: var(--segmented-hover-bg);
  color: var(--text-primary);
}

.segmented-glass .seg-btn.active {
  background: var(--segmented-active-bg);
  color: var(--segmented-active-text);
  box-shadow: var(--segmented-active-shadow);
}

.segmented-glass .seg-btn.active:hover:not(:disabled) {
  background: var(--segmented-active-hover-bg);
}

html[data-theme] .segmented-glass .seg-btn:focus-visible {
  background: var(--segmented-hover-bg);
  color: var(--text-primary);
  box-shadow: none;
}

html[data-theme] .segmented-glass .seg-btn.active:focus-visible {
  background: var(--segmented-active-bg);
  color: var(--segmented-active-text);
}

.segmented-glass .seg-btn:disabled { opacity: .5; cursor: not-allowed; }


/* ---- ../../components/Badge/badge.css ---- */
/* ==========================================================================
   Badge Component Styles - 状态指示胶囊
   - 100% 还原 modern-ui-showcase.html 脉冲发光与状态药丸
   ========================================================================== */

.badge,
.desk-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 600;
  border-radius: 999px;
  line-height: 1.2;
  background: var(--badge-bg);
  border: 1px solid transparent;
  color: var(--badge-text);
  backdrop-filter: blur(10px);
  user-select: none;
  white-space: nowrap;
}

.badge-primary,
.pill-accent {
  --badge-bg: var(--status-info-bg);
  --badge-text: var(--status-info-text);
}

.badge-success,
.pill-success {
  --badge-bg: var(--status-success-bg);
  --badge-text: var(--status-success-text);
}

.badge-warning,
.pill-warning {
  --badge-bg: var(--status-warning-bg);
  --badge-text: var(--status-warning-text);
}

.badge-danger,
.pill-danger {
  --badge-bg: var(--status-danger-bg);
  --badge-text: var(--status-danger-text);
}

.badge-neutral {
  --badge-bg: var(--status-neutral-bg);
  --badge-text: var(--status-neutral-text);
}

/* 呼吸脉冲圆点 */
.badge-dot,
.pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 0 currentColor;
  display: inline-block;
}

.badge-dot-pulse,
.pulse-dot {
  position: relative;
  /* 性能：徽标一旦挂上就是长期存在的，无限呼吸等于让合成器一直产帧
     （外扩光晕还会压着毛玻璃面板逐帧重算）。只播 3 次，之后保持高亮静态。 */
  animation: pulseBadgeBreathe 2.4s ease-in-out 3;
}

/* Expanding halo drawn behind the dot, so the pulse reads as motion. */
.badge-dot-pulse::after,
.pulse-dot::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: currentColor;
  animation: pulseBadgeHalo 2.4s ease-out 3;
  pointer-events: none;
}

@keyframes pulseBadgeBreathe {
  0%, 100% { opacity: 0.55; transform: scale(0.86); }
  50% { opacity: 1; transform: scale(1.12); }
}

@keyframes pulseBadgeHalo {
  0% { opacity: 0.5; transform: scale(1); }
  70% { opacity: 0; transform: scale(3); }
  100% { opacity: 0; transform: scale(3); }
}

@media (prefers-reduced-motion: reduce) {
  .badge-dot-pulse,
  .pulse-dot { animation: none; opacity: 1; transform: none; }
  .badge-dot-pulse::after,
  .pulse-dot::after { display: none; }
}


/* ---- ../../components/Table/table.css ---- */
/* ==========================================================================
   Table Component Styles - 数据表格规范
   - 包含极虚的分割线 (--table-border-subtle & --divider-subtle)
   - 支持 .table-container / .desk-table-container 及 .table / .desk-table 双别名
   ========================================================================== */

.table-container,
.desk-table-container {
  width: 100%;
  overflow-x: auto;
  background: var(--table-bg);
  border: var(--card-border);
  border-radius: var(--control-radius);
  box-shadow: var(--input-inner-shadow);
  backdrop-filter: blur(10px);
}

.table,
.desk-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 12.5px;
  font-family: var(--font-sans);
}

/* 表头：底带很虚的分割线 */
.table th,
.desk-table th {
  padding: 12px 16px;
  font-size: 11px;
  font-weight: 700;
  color: var(--table-header-text);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  background: var(--table-header-bg);
  border-bottom: 1px solid var(--table-divider);
  white-space: nowrap;
}

/* 数据单元格：行与行之间带有极微弱虚边线 (很虚的分割线) */
.table td,
.desk-table td {
  padding: 12px 16px;
  color: var(--table-text);
  border-bottom: 1px solid var(--table-divider);
  vertical-align: middle;
  transition: background 0.15s ease;
}

/* 行悬浮 */
.table tbody tr:hover td,
.desk-table tbody tr:hover td {
  background: var(--table-hover-bg);
}

/* 最后一行去除下边线 */
.table tbody tr:last-child td,
.desk-table tbody tr:last-child td {
  border-bottom: 0;
}

/* Markdown tables use row separators without enclosing the whole grid. */
html[data-theme] .markdown-body tbody tr:last-child td {
  border-bottom-color: transparent !important;
}

/* 等宽数字单元格 */
.table-cell-mono,
.cell-mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  font-size: 12px;
  color: var(--text-secondary);
}

/* 表格内复选框 */
.table th input[type="checkbox"],
.table td input[type="checkbox"],
.desk-table th input[type="checkbox"],
.desk-table td input[type="checkbox"] {
  cursor: pointer;
  width: 15px;
  height: 15px;
  accent-color: var(--accent-primary);
}


/* ---- ../../components/PropertyGrid/property-grid.css ---- */
/* ==========================================================================
   Property Grid Component Styles - 属性键值遥测表格 (图2 原生规范)
   - 包含极虚的分割线 (--divider-subtle)
   - 左右两列对齐，左侧图标+标签，右侧加粗等宽数值
   ========================================================================== */

.property-grid-card {
  background: var(--bg-card);
  border: var(--card-border);
  border-radius: var(--card-radius);
  padding: 18px 22px;
  box-shadow: var(--card-shadow), var(--card-rim);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  transition: all var(--transition-base);
}

html[data-theme="dark"] .property-grid-card,
[data-theme="dark"] .property-grid-card {
  background: var(--bg-card);
  border: var(--card-border);
  box-shadow: var(--card-shadow), var(--card-rim);
}

.property-grid-card:hover {
  /* no border-color change - only bg transitions allowed */
}

/* 双栏网格布局：左右之间包含极虚垂直分割线 */
.property-grid-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 0;
  row-gap: 0;
}

.property-grid-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.property-grid-columns > .property-grid-col:first-child {
  padding-right: 28px;
  border-right: 1px solid var(--property-divider); /* 左右列之间的很虚分割线 */
}

.property-grid-columns > .property-grid-col:last-child {
  padding-left: 28px;
}

@media (max-width: 860px) {
  .property-grid-columns {
    grid-template-columns: 1fr;
  }
  .property-grid-columns > .property-grid-col:first-child {
    padding-right: 0;
    border-right: none;
    border-bottom: 1px solid var(--property-divider);
    padding-bottom: 12px;
    margin-bottom: 12px;
  }
  .property-grid-columns > .property-grid-col:last-child {
    padding-left: 0;
  }
}

/* 单个属性行 */
.property-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 11px 8px;
  border-bottom: 1px solid var(--property-divider); /* 很虚的分割线 */
  transition: background-color var(--transition-fast);
  border-radius: var(--radius-sm);
}

.property-row:hover {
  background: var(--property-hover-bg);
}

/* 每一列的最后一行可以去除下边线，也可以全保留虚线 */
.property-label-group {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text-secondary);
  font-size: 13px;
  user-select: none;
  flex-shrink: 0;
  white-space: nowrap;
}

.property-icon {
  width: 16px;
  height: 16px;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.property-name {
  font-weight: 500;
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

.property-value {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--property-value-text);
  font-family: var(--font-mono);
  flex: 1;
  display: block;
  min-width: 0;
  max-width: 100%;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: normal;
  line-height: 1.4;
}

/* 特殊高亮值 */
.property-value.value-orange {
  color: var(--warning-text);
}

.property-value.value-green {
  color: var(--success-text);
}

.property-value.value-accent {
  color: var(--accent-primary);
}

.property-value.value-unknown {
  color: var(--property-unknown-text);
  font-family: var(--font-sans);
  font-weight: 500;
}

.property-value.value-danger { color: var(--status-danger-text); }


/* ---- ../../components/Card/card.css ---- */
/* ==========================================================================
   Card Component Styles - 卡片组件规范
   - 包含标准卡片与 9 大工具卡片
   - 结构之间带很虚的分割线 (border-bottom: var(--divider-subtle))
   ========================================================================== */

.card,
.glass-card-surface {
  position: relative;
  background: var(--bg-card);
  border: var(--card-border);
  border-radius: var(--card-radius);
  box-shadow: var(--card-shadow), var(--card-rim);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  transition: background-color var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  overflow: hidden;
}

.card { display: flex; flex-direction: column; }

.card::after,
.card-tool::after,
.glass-card-surface::after {
  content: "";
  position: absolute;
  right: -10px;
  bottom: -15px;
  width: 120px;
  height: 90px;
  background: var(--ambient-glow);
  pointer-events: none;
  filter: blur(20px);
  opacity: 0.5;
  z-index: 0;
  transition: background 0.3s ease;
}

.card > *,
.card-tool > *,
.glass-card-surface > * {
  position: relative;
  z-index: 1;
}

.card:hover {
  border-color: transparent;
  box-shadow: var(--card-shadow), var(--card-rim);
}

/* Nested component cards use an inset fill instead of a second floating shell. */
html[data-theme] :is(.card, .glass-card-surface) :is(.card, .glass-card-surface, .property-grid-card):not([class*="card-tone-"]),
html[data-theme] .archive-telemetry-panel :is(.property-grid-card, .archive-hash-box) {
  background: var(--surface-inset-bg) !important;
  box-shadow: none !important;
  border-radius: var(--radius-base);
}

/* 卡片头部、主体、底部 (上下结构间带很虚的分割线) */
.card-header {
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--divider-color);
}

.card-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0;
}

.card-subtitle {
  font-size: 12px;
  color: var(--text-tertiary);
  margin-top: 2px;
}

.card-body {
  padding: 20px;
  flex: 1;
}

.card-footer {
  padding: 12px 20px;
  border-top: 1px solid var(--divider-color);
  background: var(--card-footer-bg);
  display: flex;
  align-items: center;
}

/* 9 大核心工具卡片 (.card-tool) */
.card-tool {
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
  border: var(--card-border);
  border-radius: var(--card-radius);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--card-shadow), var(--card-rim);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  cursor: default;
}

.card-tool:hover {
  background: var(--bg-card-hover);
  border-color: transparent;
  transform: translateY(-2px);
  box-shadow: var(--card-hover-shadow), var(--card-rim);
}

.card-tool-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.card-tool-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-base);
  background: var(--bg-input);
  border: 1px solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-primary);
  flex-shrink: 0;
}

.card-tool-icon svg {
  width: 18px !important;
  height: 18px !important;
}

.card-tool-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0;
}

.card-tool-desc {
  font-size: 11.5px;
  color: var(--text-tertiary);
  margin-top: 1px;
}

.card-tool-body {
  font-size: 12.5px;
  color: var(--text-secondary);
  line-height: 1.5;
  flex: 1;
}

.card-tool-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid var(--divider-color);
  margin-top: 4px;
}



/* ==========================================================================
   Card surface levels (neutral only, for page layout)
   surface : plainest white panel, the default look
   muted   : one step back, light gray
   subtle  : two steps back, mid gray
   deep    : three steps back, deepest gray
   Each level also tints its own section hairlines to stay readable.
   ========================================================================== */
html[data-theme] .card.card-tone-surface {
  background: var(--bg-surface) !important;
}

html[data-theme] .card.card-tone-muted {
  background: color-mix(in srgb, var(--bg-surface) 97%, var(--text-primary)) !important;
}

html[data-theme] .card.card-tone-subtle {
  background: color-mix(in srgb, var(--bg-surface) 93%, var(--text-primary)) !important;
}

html[data-theme] .card.card-tone-deep {
  background: color-mix(in srgb, var(--bg-surface) 88%, var(--text-primary)) !important;
}

/* Hairlines: each level gets a divider that stays visible on its own surface. */
html[data-theme] .card.card-tone-surface.card-divided > .card-header,
html[data-theme] .card.card-tone-surface.card-divided > .card-body + .card-footer { border-color: var(--divider-color) !important; }
html[data-theme] .card.card-tone-muted.card-divided > .card-header,
html[data-theme] .card.card-tone-muted.card-divided > .card-body + .card-footer { border-color: color-mix(in srgb, var(--text-primary) 7%, transparent) !important; }
html[data-theme] .card.card-tone-subtle.card-divided > .card-header,
html[data-theme] .card.card-tone-subtle.card-divided > .card-body + .card-footer { border-color: color-mix(in srgb, var(--text-primary) 10%, transparent) !important; }
html[data-theme] .card.card-tone-deep.card-divided > .card-header,
html[data-theme] .card.card-tone-deep.card-divided > .card-body + .card-footer { border-color: color-mix(in srgb, var(--text-primary) 13%, transparent) !important; }

/* Titled hairlines stay neutral; no colored glow behind gray surfaces. */
html[data-theme] .card[class*="card-tone-"]::after { display: none; }

/* Hairline separators between card sections (neutral default). */
html[data-theme] .card.card-divided > .card-header { border-bottom: 1px solid var(--divider-color); }
html[data-theme] .card.card-divided > .card-body + .card-footer { border-top: 1px solid var(--divider-color); }

/* Property rows: icon + label left, value right, hairline between rows. */
.card-property-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 10px 20px; }
.card-property-row + .card-property-row { border-top: 1px solid var(--divider-color); }
.card-property-label { display: inline-flex; align-items: center; gap: 9px; min-width: 0; color: var(--text-secondary); font-size: 12.5px; }
.card-property-label svg { flex: 0 0 auto; color: var(--text-tertiary); }
.card-property-value { flex: 0 0 auto; color: var(--text-primary); font-size: 12.5px; font-weight: 600; }

/* Toned cards inherit the standard card shell (soft shadow + inner rim +
   glass blur) and only swap the surface fill. Nothing else is overridden,
   so a toned card looks exactly like a default card in a different shade. */

/* Toned cards keep the standard shadow but replace the white inner rim with a
/* Toned cards keep a shadow-only edge, exactly like the large panel. The base
   card shadow is tuned for a white surface, so tinted levels get a slightly
   tighter contact shadow to keep the silhouette readable. No border, no ring. */
html[data-theme] .card[class*="card-tone-"] {
  border: 0 !important;
  box-shadow: var(--card-shadow), 0 1px 3px color-mix(in srgb, var(--text-primary) 10%, transparent) !important;
}

html[data-theme] .card[class*="card-tone-"]:hover {
  border: 0 !important;
  box-shadow: var(--card-shadow), 0 1px 3px color-mix(in srgb, var(--text-primary) 12%, transparent) !important;
}
/* Property-row separators follow the surface level too: the neutral divider is
   tuned for white panels and disappears on the deeper shades. */
html[data-theme] .card.card-tone-surface .card-property-row + .card-property-row { border-top-color: var(--divider-color); }
html[data-theme] .card.card-tone-muted .card-property-row + .card-property-row { border-top-color: color-mix(in srgb, var(--text-primary) 8%, transparent); }
html[data-theme] .card.card-tone-subtle .card-property-row + .card-property-row { border-top-color: color-mix(in srgb, var(--text-primary) 12%, transparent); }
html[data-theme] .card.card-tone-deep .card-property-row + .card-property-row { border-top-color: color-mix(in srgb, var(--text-primary) 16%, transparent); }


/* ---- ../../components/SessionTabs/session-tabs.css ---- */
.session-tabs { display: flex; align-items: center; gap: 4px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
.session-tabs::-webkit-scrollbar { display: none; }
.session-tab { display: inline-flex; align-items: center; flex: 0 0 auto; height: var(--session-tab-height, 26px); border: 0; border-radius: 6px; color: var(--session-tab-text); background: var(--session-tab-bg); transition: color var(--transition-fast), background var(--transition-fast); }
.session-tab:hover { color: var(--session-tab-active-text); background: var(--session-tab-hover-bg); }
.session-tab.active { color: var(--session-tab-active-text); background: var(--session-tab-active-bg); }
.session-tab.active:hover { background: var(--session-tab-active-hover-bg); }
.session-tab-select { display: inline-flex; align-items: center; height: 100%; min-width: 0; padding: 0 9px; border: 0; border-radius: inherit; color: inherit; background: transparent; font: inherit; font-size: var(--session-tab-font-size, 11px); white-space: nowrap; cursor: pointer; }
.session-tab.active .session-tab-select { font-weight: 600; }
.session-tab-close { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 19px; height: 19px; margin-right: 4px; padding: 0; border: 0; border-radius: 4px; color: inherit; background: transparent; cursor: pointer; }
.session-tab-close:hover { background: var(--session-tab-active-hover-bg); }
.session-tab-select:focus-visible, .session-tab-close:focus-visible { outline: 1px solid currentColor; outline-offset: -2px; }


/* ---- ../../components/ConfirmDialog/confirm-dialog.css ---- */
/* ---- ../../components/RenameDialog/rename-dialog.css ---- */
/* ==========================================================================
   RenameDialog - 单输入弹窗（重命名对话 / 工作区）
   ========================================================================== */

.rename-dialog-input {
  width: 100%;
  height: 38px;
  padding: 0 12px;
  box-sizing: border-box;
  /* --input-border 是完整的 border 简写（含 1px solid），别往 border-color 里塞。 */
  border: var(--input-border);
  border-radius: 10px;
  background: var(--input-bg-sunken);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: 13.5px;
  line-height: 20px;
  outline: none;
  transition: border-color var(--transition-fast), background-color var(--transition-fast);
}

.rename-dialog-input:hover:not(:disabled) {
  background: var(--input-bg-hover);
}

.rename-dialog-input:focus {
  border-color: var(--accent-primary);
  background: var(--input-bg-focus);
}

.rename-dialog-input:disabled { opacity: 0.6; cursor: not-allowed; }

.rename-dialog-error {
  margin: 8px 0 0;
  font-size: 12px;
  line-height: 1.5;
  color: var(--status-danger-text);
  overflow-wrap: anywhere;
}
/* ==========================================================================
   ConfirmDialog Styles - 二次确认警示弹窗规范
   ========================================================================== */

.confirm-dialog-overlay {
  position: fixed;
  inset: 0;
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--overlay-bg);
  backdrop-filter: blur(4px);
  animation: confirmFadeIn 0.18s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes confirmFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.confirm-dialog-modal {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  width: min(440px, 94vw);
  padding: 22px;
  background: var(--popover-bg);
  border: var(--popover-border);
  border-radius: 18px;
  box-shadow: var(--popover-shadow), inset 0 1px 1px 0 rgba(255, 255, 255, 0.16);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  animation: confirmScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes confirmScaleIn {
  from {
    opacity: 0;
    transform: scale(0.95) translateY(6px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.confirm-dialog-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: var(--status-danger-bg);
  color: var(--status-danger-text);
  flex-shrink: 0;
}

.confirm-dialog-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
  min-width: 0;
}

.confirm-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.confirm-dialog-title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.confirm-dialog-close-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 6px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-tertiary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.confirm-dialog-close-btn:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
  border-color: transparent;
}

.confirm-dialog-message {
  margin: 0;
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.confirm-dialog-error {
  margin: 0;
  color: var(--status-danger-text);
  font-size: 12px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.confirm-dialog-close-btn:disabled { opacity: 0.45; cursor: not-allowed; }

.confirm-dialog-acknowledge {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 0 0 14px;
  color: var(--text-secondary);
  font-size: 12.5px;
  line-height: 1.45;
  cursor: pointer;
}

.confirm-dialog-acknowledge input {
  margin-top: 2px;
  accent-color: var(--danger-text);
}

.confirm-dialog-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 8px;
}

.confirm-dialog-actions .btn-primary {
  --btn-primary-bg: var(--btn-confirm-bg);
  --btn-primary-hover: var(--btn-confirm-hover);
  --btn-primary-text: var(--btn-confirm-text);
}

.confirm-dialog-actions .btn-primary:disabled {
  background: var(--btn-secondary-bg);
  color: var(--text-tertiary);
  opacity: .65;
}


/* ---- ../../components/ToolEmptyState/tool-empty-state.css ---- */
.tool-empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 112px;
  padding: 20px;
  color: var(--tool-state-muted);
  background: var(--tool-state-bg);
}
.tool-empty-state > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
  max-width: 520px;
}
.tool-empty-title {
  color: var(--tool-state-text);
  font-size: 13px;
  line-height: 1.5;
  font-weight: 500;
}
.tool-empty-state p {
  margin: 0;
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.tool-empty-state.compact {
  min-height: 0;
  padding: 10px 16px;
  justify-content: flex-start;
  flex: none;
  border-radius: var(--radius-sm);
}
.tool-empty-state.compact > div { gap: 2px; }
.tool-empty-state.compact .tool-empty-title { font-size: 12.5px; }
.tool-empty-state.compact p { font-size: 11.5px; }
.tool-empty-state svg { flex: none; color: var(--tool-state-muted); }


/* ---- ../../components/ToolIcon/tool-icon.css ---- */
.tool-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 10px;
  color: var(--accent-primary);
  background: var(--accent-subtle);
}

.tool-icon > svg {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  stroke-width: 1.75;
}

/* 尺寸档：sm 24 / md 36（默认）/ lg 44 */
.tool-icon.is-sm {
  width: 24px;
  height: 24px;
  border-radius: 7px;
}

.tool-icon.is-sm > svg {
  width: 14px;
  height: 14px;
}

.tool-icon.is-lg {
  width: 44px;
  height: 44px;
  border-radius: 12px;
}

.tool-icon.is-lg > svg {
  width: 22px;
  height: 22px;
}

/* 工具图标不按色相区分：颜色只表达状态，底与字都走中性 */
.tool-icon.is-neutral {
  color: var(--text-secondary);
  background: var(--bg-muted);
}

/* ---- ../../components/BorderGlow/border-glow.css ---- */
.border-glow-card {
  position: relative;
  display: grid;
  isolation: isolate;
  overflow: visible;
  border: 0;
  box-shadow: none;
}

.border-glow-layer {
  position: absolute;
  inset: -1px;
  z-index: 0;
  pointer-events: none;
  box-sizing: border-box;
  /* Cut out the interior instead of painting over it with a translucent surface. */
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  opacity: var(--glow-opacity, 0);
  transition: opacity 0.2s ease-out;
}

.border-glow-inner {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  flex-direction: column;
}


/* ---- ../../components/BootScreen/boot-screen.css ---- */
html.boot-mode,
html.boot-mode body,
html.boot-mode #root {
  background: transparent !important;
  overflow: hidden;
}

.boot-screen {
  display: grid;
  width: 100vw;
  height: 100vh;
  place-items: center;
  overflow: hidden;
  background: transparent;
}

.boot-orb {
  position: absolute;
  width: 180px;
  height: 180px;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.32) 0%, rgba(6, 182, 212, 0.2) 45%, transparent 70%);
  filter: blur(28px);
  opacity: 0.95;
  animation: boot-pulse 2.2s ease-in-out infinite;
}

.boot-content {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 100%;
}

.boot-logo {
  width: 84px;
  height: 84px;
  filter: drop-shadow(0 16px 36px rgba(37, 99, 235, 0.35));
  animation: boot-spin 1.15s linear infinite;
}

@keyframes boot-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes boot-pulse {
  0%, 100% { transform: scale(0.92); opacity: 0.75; }
  50% { transform: scale(1.08); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .boot-logo,
  .boot-orb {
    animation: none;
  }
}

/* 3. ui/ 下自管样式（各自 tsx 里 import 了，这里重复声明是为了让
     纯 CSS 引入方也能拿到完整样式；打包后由 Vite 去重） */

/* ---- ../../components/ui/toast.css ---- */
/* ==========================================================================
   Toast / Notification
   - One stack, bottom-right, above page content.
   - Neutral surface; the icon alone carries the tone.
   - Entrance is a short rise; no bounce, no colour wash.
   - The action is a library Button (`secondary` / `xs`). The close glyph is a
     plain icon button: nothing at rest, red only on hover — the same
     treatment as the attachment remove button.
   ========================================================================== */

.ui-toast-stack {
  position: fixed;
  z-index: 90;
  right: 20px;
  bottom: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-width: min(380px, calc(100vw - 40px));
  pointer-events: none;
}

.ui-toast {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 9px 9px 9px 12px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: var(--toast-bg);
  color: var(--toast-text);
  box-shadow: var(--toast-shadow);
  font-size: 12.5px;
  line-height: 1.55;
  pointer-events: auto;
  animation: ui-toast-rise 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Static previews sit inside a page flow, not the fixed stack. */
.ui-toast.is-static {
  position: static;
  width: 100%;
  max-width: 380px;
  animation: none;
}

.ui-toast-icon {
  display: inline-flex;
  flex: 0 0 auto;
  margin-top: 2px;
  color: var(--text-secondary);
}

.ui-toast.is-success .ui-toast-icon { color: var(--status-success-text); }
.ui-toast.is-error .ui-toast-icon { color: var(--status-danger-text); }
.ui-toast.is-info .ui-toast-icon { color: var(--accent-primary); }

.ui-toast-text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

/* ── Action: library Button, secondary glass ───────────────────────────────
   Fill, hover fill, radius, shadow and ink all come from `button.css`.
   Only the vertical offset is local, so the button sits on the text baseline
   instead of bottom-aligning to the row. */
.ui-toast .ui-toast-action.btn {
  flex: 0 0 auto;
  align-self: center;
  margin-top: -1px;
}

/* ── Close: bare glyph, danger only on hover ───────────────────────────────
   Deliberately NOT a filled chip: next to the filled action it would compete,
   and a close control should stay out of the way. At rest it is just the ×;
   hovering fills it with the danger tint, exactly like the attachment remove
   button. The `subtle` variant is kept only for its interaction semantics —
   its resting fill and lift are stripped here. */
.ui-toast .ui-toast-close.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  align-self: center;
  width: 24px;
  min-width: 24px;
  height: 24px;
  padding: 0;
  margin-top: -1px;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  color: var(--text-tertiary);
  transition: background-color var(--transition-fast), color var(--transition-fast),
    border-color var(--transition-fast);
}

.ui-toast .ui-toast-close.btn:hover:not(:disabled) {
  color: var(--status-danger-text);
  background: color-mix(in srgb, var(--danger-text) 12%, transparent);
  border-color: transparent;
}

.ui-toast .ui-toast-close.btn:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 1px;
}

@keyframes ui-toast-rise {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .ui-toast { animation: none; }
  .ui-toast .ui-toast-close.btn { transition: none; }
}


/* ---- ../../components/ui/list-item.css ---- */
/* ==========================================================================
   ListItem — the repeating settings/list row.
   Hover is an inset rounded block, not a full-bleed band: the highlight sits
   inside the row with its own radius, matching the settings panels where the
   tint never touches the card edge.
   ========================================================================== */

.ui-list-item {
  position: relative;
  padding: 2px 0;
  border-bottom: 1px solid var(--border-subtle);
}

.ui-list-item.no-divider { border-bottom: none; }

/* Keep the disclosure button separate from sibling switches and actions. */
.ui-list-item-hit.btn, .ui-list-item-static {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  flex: 1;
  gap: 10px;
  min-width: 0;
  padding: 0;
  white-space: normal;
  border: 0;
  border-radius: 8px;
  background: transparent;
  font-family: inherit;
  color: inherit;
  text-align: left;
  cursor: pointer;
  transition: background-color var(--transition-fast);
}

.ui-list-item.is-interactive > .ui-list-item-row:hover {
  background: var(--bg-hover);
}

.ui-list-item.is-selected > .ui-list-item-row { background: var(--bg-selected); }

.ui-list-item-hit:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: -2px;
}

.ui-list-item.is-dense > .ui-list-item-row { padding-block: 6px; }
.ui-list-item-static { cursor: default; }

/* Non-clickable rows keep the same geometry without the button element. */
.ui-list-item > .ui-list-item-row {
  padding: 8px 10px;
  border-radius: 8px;
}


.ui-list-item-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  justify-content: space-between;
  transition: background-color var(--transition-fast);
}

.ui-list-item-chevron {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 18px;
  color: var(--text-tertiary);
  transition: transform var(--transition-fast);
}

.ui-list-item.is-expanded .ui-list-item-chevron { transform: rotate(90deg); }

.ui-list-item-leading {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-top: 1px;
  color: var(--text-secondary);
}

.ui-list-item-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-width: 0;
}

.ui-list-item-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  min-width: 0;
}

.ui-list-item-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}

.ui-list-item-meta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
}

.ui-list-item-desc {
  font-size: 12px;
  line-height: 1.6;
  color: var(--control-text);
  overflow-wrap: anywhere;
}

.ui-list-item-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  font-size: 11px;
  color: var(--control-text);
  overflow-wrap: anywhere;
}

.ui-list-item-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
  padding-top: 2px;
}

/* Leave a gap below the row's hover fill so expanded cards keep their own
   silhouette instead of touching the disclosure highlight. */
.ui-list-item-extra {
  margin: 8px 10px 12px;
  animation: ui-list-item-reveal 0.16s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes ui-list-item-reveal {
  from { opacity: 0; transform: translateY(-2px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Narrow widths: the action cluster drops under the text instead of squeezing
   the description into a one-word-per-line column. */
.ui-list-item.is-compact .ui-list-item-row { flex-wrap: wrap; }
.ui-list-item.is-compact :is(.ui-list-item-hit, .ui-list-item-static) { flex-basis: 100%; }
.ui-list-item.is-compact .ui-list-item-actions { margin-left: auto; }

@media (prefers-reduced-motion: reduce) {
  .ui-list-item-extra { animation: none; }
  .ui-list-item-chevron { transition: none; }
}


/* ---- ../../components/ui/notice-panel.css ---- */
/* ==========================================================================
   NoticePanel — one card per notice, spanning the composer column.
   Width is fixed to the container (the chat footer column), not to content:
   a notice must not grow or shrink when it expands, and the +N −N file row
   needs room reserved for it before it opens.

     width: 100%  → matches the 860px / 100%-48px composer column
     no max-content, no per-kind cap → expanding never changes the outer size
   ========================================================================== */

/* 通知卡是浮在对话内容上方的，**不能带透明度**：主题里的 --bg-card 本身是
   rgba（亮色 .85 / 暗色渐变 .98），白字黑底或黑字白底都会从卡片里透出来，
   滚动时尤其明显。这里换成一层不透明的卡片底色：先在 --bg-canvas（页面底色）
   上叠 --bg-card，再把 alpha 吃掉 —— 既保留卡片与画布之间的色差，又保证
   填充完全不透明。两套主题、自定义主题都走同一条规则。 */
.ui-notice {
  --notice-fill: color-mix(in srgb, var(--bg-card) 100%, var(--bg-canvas));
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  background-color: var(--bg-canvas);
  background-image: linear-gradient(var(--notice-fill), var(--notice-fill));
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.ui-notice-heading {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 0;
  min-width: 0;
}

/* The summary is a library Button (variant="bare"). `.btn` sets display and
   gap at (0,1,0); this rule must win over it, so it carries the .btn prefix. */
.ui-notice-summary.btn.btn-bare {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 8px;
  min-width: 0;
  min-height: 36px;
  /* Symmetric padding: the hover fill must reach both edges, no right gutter. */
  padding: 4px 12px;
  border: 0;
  border-radius: 0;
  color: var(--text-primary);
  background: transparent;
  box-shadow: none;
  font: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
  transition: background-color var(--transition-fast);
}

/* Hover must outrank the base rule above: that one is written as
   `.ui-notice-summary.btn.btn-bare` (0,3,0), so a plain `:hover` (0,2,0) would
   lose and the fill would never appear. */
.ui-notice-summary.btn.btn-bare:hover:not(:disabled) {
  background: var(--button-hover-bg);
}

.ui-notice-summary:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: -2px;
}

.ui-notice-icon {
  display: inline-flex;
  flex: 0 0 15px;
  width: 15px;
  height: 15px;
  color: var(--text-secondary);
}

.ui-notice-icon svg { width: 15px; height: 15px; stroke-width: 1.7; }

.ui-notice-label {
  flex: 0 0 auto;
  font-weight: 500;
  white-space: nowrap;
}

.ui-notice-meta {
  flex: 0 0 auto;
  margin-left: 4px;
}

.ui-notice-preview {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--control-text);
}

/* Diff counts: the only place colour enters the summary line. */
.ui-notice-preview em {
  font-style: normal;
  font-variant-numeric: tabular-nums;
  margin-right: 6px;
}

.ui-notice-preview em:first-child { color: var(--status-success-text); }
.ui-notice-preview em:last-child { color: var(--status-danger-text); }

/* `count` (任务数/文件数) sits at the far right; `meta` (进度 pill) must stay
   next to the summary text, so only count gets the auto margin. */
.ui-notice-count {
  flex: 0 0 auto;
  margin-left: auto;
  font-size: 11px;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.ui-notice-chevron {
  flex: 0 0 auto;
  margin-left: 6px;
  color: var(--text-tertiary);
  transition: transform 0.15s ease;
}

/* 收起态 = 直角箭头（朝右 > ），展开态 = 下箭头（v）——权限申请、AI 询问、任务编排、
   后台任务和追加消息卡全部同一套，靠这里统一，不要再按 variant 各写一份。 */
.ui-notice.is-expanded > .ui-notice-heading .ui-notice-chevron { transform: rotate(90deg); }
.ui-notice.is-compact.is-expanded > .ui-notice-heading .ui-notice-chevron { transform: rotate(90deg); }
/* 收起态 = 直角箭头（朝右），展开态 = 下箭头。inline 卡的汇总头自己带箭头，
   不走 `.ui-notice-heading` 那条规则，单独给。 */
.ui-notice.is-inline.is-expanded > .ui-notice-summary.is-static .ui-notice-chevron { transform: rotate(90deg); }

.ui-notice-actions {
  display: flex;
  align-items: center;
  gap: 4px;
  flex: 0 0 auto;
}

/* A status ring in the badge slot (后台任务) must not stretch the heading:
   the shared indicator is 18px, taller than the 11px count text it replaced. */
.ui-notice-heading .ui-notice-badge,
.ui-notice-heading > .agent-activity-status {
  flex: 0 0 auto;
  margin-left: 2px;
}

/* Expanded body stays inside the same card, divided by a hairline. */
.ui-notice-content {
  min-height: 0;
  overflow: auto;
  overscroll-behavior: contain;
  min-width: 0;
  padding: 10px 12px;
  border-top: 1px solid var(--border-subtle);
  font-size: 12px;
  color: var(--text-primary);
}

/* ── Compact rows (文件改动): half width, fixed before and after expand ──
   The product caps compact rows with width: max-content / max-width 420px.
   Here the width is fixed instead so opening the file list never resizes the
   card: half the column, capped, with a floor so paths stay readable. */
.ui-notice.is-compact {
  width: min(50%, 420px);
  min-width: 300px;
}

.ui-notice.is-compact .ui-notice-heading { padding-right: 0; }
.ui-notice.is-compact .ui-notice-preview { flex: 0 0 auto; overflow: visible; }
.ui-notice.is-compact .ui-notice-summary { padding: 5px 12px; }

/* ── Tone tints the icon and the card edge, never the fill ──────────────── */
.ui-notice.is-attention .ui-notice-icon { color: var(--accent-primary); }
.ui-notice.is-attention { border-color: color-mix(in srgb, var(--accent-primary) 32%, var(--border-subtle)); }

.ui-notice.is-warning .ui-notice-icon { color: var(--status-warning-text); }
.ui-notice.is-warning { border-color: color-mix(in srgb, var(--warning-text) 34%, var(--border-subtle)); }

.ui-notice.is-danger .ui-notice-icon { color: var(--status-danger-text); }
.ui-notice.is-danger { border-color: color-mix(in srgb, var(--danger-text) 34%, var(--border-subtle)); }

.ui-notice.is-success .ui-notice-icon { color: var(--status-success-text); }
/* 成功也要有描边：danger / warning / attention 都有，唯独 success 缺了一圈。 */
.ui-notice.is-success { border-color: color-mix(in srgb, var(--success-text) 30%, var(--border-subtle)); }

/* ── Inline rows (追加消息) ──────────────────────────────────────────────
   内联卡片不折叠，但外壳必须和其它通知一模一样：同一个圆角、同一圈描边、
   同一层阴影，头部一行（图标 + 名称 + 摘要 + 计数）只是不可点击。
   Placement and the input-corner inset belong to the composer dock. */
.ui-notice.is-inline {
  width: 100%;
  margin-inline: 0;
  padding: 0;
  gap: 0;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  /* 与 `.ui-notice` 同一套不透明填充（见文件顶部），不要再写回 var(--bg-card)。 */
  background-color: var(--bg-canvas);
  background-image: linear-gradient(var(--notice-fill), var(--notice-fill));
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 静态头部与可点击头部的内边距/行高对齐（.ui-notice-summary 是 4px 12px / 36px）。 */
.ui-notice-heading.is-static {
  min-height: 36px;
  padding: 4px 12px;
  box-sizing: border-box;
}

.ui-notice-heading.is-static .ui-notice-label,
.ui-notice-heading.is-static .ui-notice-preview {
  min-width: 0;
}

/* ── Queue rows inside a notice ─────────────────────────────────────────── */
/* 样式来自 design-drafts/steer-cards：单条是「灵动浮岛胶囊」，多条是
   「汇总头 + 行列表」。按钮逻辑不变，只换壳。 */
.ui-notice-queue-row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  /* 行高向普通通知头（36px）看齐：设计稿的 40/44px 放在我们这套密集停靠区里
     比「AI 询问」高一大截，一张卡就把输入框顶上去半屏。 */
  min-height: 32px;
  padding: 4px 12px 4px 14px;
  box-sizing: border-box;
  background: transparent;
  transition: background var(--transition-base, 0.22s var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)));
}
.ui-notice-queue-row.is-single {
  gap: 8px;
  min-height: 36px;
  padding: 6px 12px 6px 14px;
}
/* 单条胶囊没有排序可言，拖拽柄整个隐去（键盘上/下移也随之无意义）。 */
.ui-notice-queue-row.is-single .ui-notice-queue-drag { display: none; }

/* 排队行本身不做 hover 铺底：整行不是可点目标（可点的是行尾那几个图标按钮），
   一 hover 就浮出一块底色会让整张卡看起来在闪。按钮自己保留 hover。 */

/* 行号：mono 11px 灰，占 18px 槽位 */
.ui-notice-queue-index {
  flex: 0 0 18px;
  width: 18px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  text-align: center;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* 单条形态：呼吸灯 + 「等待中：」都要跟正文拉开距离——8px 时圆点几乎贴住「已」字，
   呼吸环外扩之后还会压到字上，所以圆点占 10px 槽位、整体 gap 加到 8px。 */
.ui-notice-queue-dot {
  flex: 0 0 8px;
  width: 8px;
  height: 8px;
  margin: 0 2px;
  border-radius: 50%;
  background: var(--accent-primary);
  position: relative;
}
.ui-notice-queue-dot::after {
  content: "";
  position: absolute;
  inset: -3px;
  border-radius: 50%;
  border: 1.5px solid var(--accent-primary);
  /* 性能：原来是 infinite。这个环会从 0.7 倍扩到 2.4 倍，每帧都在毛玻璃
     面板上扫过大片区域，实测占掉约 35% 单核。改成只播 3 次：出现时足够
     提示「有排队消息」，之后静止，稳态不再产帧。 */
  animation: ui-queue-pulse-ring 1.8s cubic-bezier(0.24, 0, 0.38, 1) 3;
}
@keyframes ui-queue-pulse-ring {
  0% { transform: scale(0.7); opacity: 0.9; }
  100% { transform: scale(2.4); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .ui-notice-queue-dot::after { animation: none; opacity: 0; }
}

.ui-notice-queue-single-label {
  flex: 0 0 auto;
  margin-right: 5px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
}

.ui-notice-queue-drag.btn.btn-bare { flex: 0 0 18px; width: 18px; min-width: 18px; height: 22px; padding: 0; color: var(--text-tertiary); cursor: grab; touch-action: none; user-select: none; }
.ui-notice-queue-drag.btn.btn-bare:active { cursor: grabbing; }
.ui-notice-queue-drag.btn.btn-bare:hover:not(:disabled) { color: var(--text-secondary); background: var(--bg-hover); }
.ui-notice-queue-row.is-dragging { opacity: .52; }
.ui-notice-queue-preview { display: flex; align-items: center; gap: 4px; flex: 0 0 auto; }
.ui-notice-queue-thumbnail { display: grid; place-items: center; width: 18px; height: 18px; padding: 0; border: 1px solid var(--border-subtle); border-radius: 4px; background: var(--bg-surface); color: var(--text-tertiary); overflow: hidden; cursor: pointer; }
.ui-notice-queue-thumbnail img { width: 100%; height: 100%; object-fit: cover; }
.ui-notice-queue-preview small { color: var(--text-tertiary); font-size: 11px; }
.ui-notice-queue-file { display: inline-flex; align-items: center; gap: 4px; max-width: 72px; min-width: 0; height: 18px; padding: 0 5px; border: 1px solid var(--border-subtle); border-radius: 4px; color: var(--text-secondary); background: var(--bg-surface); font-size: 10.5px; }
.ui-notice-queue-file > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ui-notice-queue-file .local-path-icon { width: 14px; height: 14px; flex: 0 0 auto; }
.ui-notice-queue-text {
  flex: 1;
  min-width: 0;
  font-size: 12.5px;
  font-weight: 450;
  line-height: 1.45;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ui-notice-queue-text.is-single-text { color: var(--text-secondary); }

.ui-notice-queue-actions {
  display: flex;
  align-items: center;
  gap: 2px;
  flex: 0 0 auto;
}
/* 三按钮 = 设计稿 `.s1-action-btn`：26×26、radius 7、15px 图标、中性灰底色，
   hover 才浮出 `--bg-hover`。三个按钮共用同一套中性灰，强调色只留给状态与进度，
   卡片上不出现第二处彩色焦点（m10690：上一版把「追加」画成强调色是错的）。 */
.ui-notice-queue-actions .btn.btn-bare { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; min-width: 26px; padding: 0; gap: 0; border: 0; border-radius: 7px; background: transparent; color: var(--text-tertiary); font: 500 12px/1.4 var(--font-sans); }
.ui-notice-queue-actions .btn svg { width: 15px; height: 15px; }
.ui-notice-queue-actions .btn.btn-bare:hover:not(:disabled) { color: var(--text-primary); background: var(--bg-hover); }
.ui-notice-queue-actions .btn.btn-bare:disabled { opacity: 0.32; }

/* ── File rows inside a notice ──────────────────────────────────────────── */
.ui-notice-file-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 8px;
  border-radius: 8px;
  font: 11.5px/1.5 var(--font-mono);
}

.ui-notice-file-row:hover { background: var(--bg-hover); }

.ui-notice-file-row > span {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-secondary);
}

.ui-notice-file-row em {
  text-align: right;
  flex: 0 0 auto;
  font-style: normal;
  font-variant-numeric: tabular-nums;
  color: var(--status-success-text);
}

.ui-notice-file-row i {
  text-align: right;
  flex: 0 0 auto;
  font-style: normal;
  font-variant-numeric: tabular-nums;
  color: var(--status-danger-text);
}

/* Progress pill used by 任务编排's meta slot. */
.composer-task-progress-pill {
  flex: 0 0 auto;
  padding: 1px 7px;
  border-radius: 999px;
  background: var(--accent-subtle);
  color: var(--accent-primary);
  font-size: 10.5px;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* Narrow windows: half the column is too tight for file paths, so compact
   rows take the full width there instead of shrinking further. */
@media (max-width: 720px) {
  .ui-notice.is-compact {
    width: 100%;
    min-width: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ui-notice-chevron,
  .ui-notice-summary { transition: none; }
}

/* Shared 09 bodies: the showcase and production adapters use these same rows. */
.ui-notice-body-stack, .ui-notice-background-task { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.ui-notice-body-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.ui-notice-code { margin: 0; padding: 10px; border-radius: 8px; background-color: var(--bg-surface); background-image: linear-gradient(var(--markdown-code-bg), var(--markdown-code-bg)); font: 11.5px/1.6 var(--font-mono); overflow: auto; white-space: pre; }
.ui-notice-reply { display: flex; align-items: center; gap: 8px; }
.ui-notice-reply > .input-shell { flex: 1; min-width: 0; }
.ui-notice-detail { color: var(--text-tertiary); font-size: 11px; }
.ui-notice-background-task { gap: 8px; }
.ui-notice-background-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 12px; }
/* 标题行本身是折叠开关：整行可点，但只用 bare 按钮占住「图标+文字」那段，
   右侧的用时/停止按钮仍然是独立可点的动作，不会连带折叠。 */
.ui-notice-background-toggle.btn.btn-bare {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 6px;
  min-width: 0;
  padding: 0;
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 500;
  text-align: left;
}
.ui-notice-background-toggle.btn.btn-bare:hover:not(:disabled) { color: var(--text-primary); }
.ui-notice-background-toggle > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ui-notice-background-chevron {
  flex: 0 0 auto;
  color: var(--text-tertiary);
  transition: transform 140ms ease;
}
.ui-notice-background-task.is-expanded .ui-notice-background-chevron { transform: rotate(90deg); }
.ui-notice-background-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
/* `hidden` 必须显式压回 none：上面给了 display:flex，否则收起时内容照样在。 */
.ui-notice-background-body[hidden] { display: none; }
.ui-notice-background-log { max-height: 200px; font-size: 11px; }
.ui-notice-background-task details { min-width: 0; color: var(--text-secondary); font-size: 11px; }
.ui-notice-background-task details summary { cursor: pointer; }
.ui-notice-background-task details[open] > :not(summary) { margin-top: 8px; }
@media (prefers-reduced-motion: reduce) {
  .ui-notice-background-chevron { transition: none; }
}

/* 「任务详情」套一层独立的卡片壳：标题行和上面的日志面本身就是两块有填充的
   面板，details 直接铺在通知底色上会被读成底色的一部分，而不是又一块内容。
   这里复用组件库的 Card，但压平为 inset 填充（不加第二层浮起阴影）。 */
html[data-theme] .ui-notice-background-task .ui-notice-background-detail {
  padding: 8px 10px;
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
  background: var(--surface-inset-bg);
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
html[data-theme] .ui-notice-background-task .ui-notice-background-detail::after { display: none; }
.ui-notice-background-detail > details { min-width: 0; }

/* 日志块和「任务详情」是卡片里再套的两层填充，同样不能带 alpha：暗色主题的
   --markdown-code-bg 是 rgba(18,22,30,.92)、亮色是 rgba(255,255,255,.95)，
   叠在不透明卡片上仍会让上层的文字/滚动内容透出来。这里先把每一层的 alpha
   吃掉（混进卡片自己的 --notice-fill），再把卡片拆成「--bg-canvas 垫底 +
   去 alpha 的填充盖面」，两层都不透明；顺序反过来会留下一个半透明的底色。 */
html[data-theme] .ui-notice .ui-notice-code {
  background-color: var(--notice-fill);
  background-image: linear-gradient(
    color-mix(in srgb, var(--markdown-code-bg) 100%, var(--notice-fill)),
    color-mix(in srgb, var(--markdown-code-bg) 100%, var(--notice-fill))
  );
}
html[data-theme] .ui-notice-background-task .ui-notice-background-detail {
  background-color: var(--bg-canvas);
  background-image: linear-gradient(
    color-mix(in srgb, var(--surface-inset-bg) 100%, var(--notice-fill)),
    color-mix(in srgb, var(--surface-inset-bg) 100%, var(--notice-fill))
  );
}

/* 亮色主题下 --markdown-code-bg 是 rgba(255,255,255,.95)、--surface-inset-bg 是
   白底混 2% 文字色，两者都贴住通知的白色外壳：日志块和「任务详情」的卡片边界
   于是整个消失（暗色主题下面板有自己的深底色，对比本来就够，所以只修亮色）。
   这里换成一层可见的浅灰填充 + 淡边框；详情卡内部的命令块再回到白底，
   保证「日志块 → 任务详情卡 → 命令块」三层仍然分得开。
   `background-color` 只是不透明垫底，可见的那一层仍是上面的去 alpha 填充。 */
html[data-theme="light"] .ui-notice .ui-notice-code,
html[data-theme="light"] .ui-notice .ui-notice-background-detail {
  background-color: var(--bg-canvas);
  background-image: linear-gradient(
    color-mix(in srgb, var(--text-primary) 8%, var(--bg-surface)),
    color-mix(in srgb, var(--text-primary) 8%, var(--bg-surface))
  );
  border: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
}
html[data-theme="light"] .ui-notice .ui-notice-background-detail .ui-notice-code {
  background-color: var(--bg-canvas);
  background-image: linear-gradient(var(--bg-surface), var(--bg-surface));
  border-color: color-mix(in srgb, var(--text-primary) 8%, transparent);
}
.ui-notice-error { margin: 0; color: var(--status-danger-text); overflow-wrap: anywhere; }
.ui-notice-file-list { display: flex; flex-direction: column; gap: 4px; }
.ui-notice-file-row.btn.btn-bare { display: flex; width: 100%; min-width: 0; gap: 8px; padding: 4px 8px; border-radius: 8px; font: 11.5px/1.5 var(--font-mono); text-align: left; }
.ui-notice-file-row.is-deleted > span { text-decoration: line-through; }
/* 卡片外壳现在由 `.ui-notice.is-inline` 提供：这里只负责纵向排布，不再画第二圈
   描边/底色（否则卡片里套一层卡，圆角还会互相打架）。单条形态没有行分隔线，
   行列表形态保留 1px 分隔 + 6px 细滚动条（steer-cards 规范）。 */
.ui-notice-queue-list { display: flex; flex-direction: column; gap: 0; min-height: 0; overflow: auto; border: 0; border-radius: 0; background: transparent; scrollbar-width: thin; }
.ui-notice-queue-list:not(.is-single) { border-top: 1px solid var(--border-subtle); max-height: 190px; box-sizing: border-box; padding-bottom: 2px; overscroll-behavior: contain; }
.ui-notice-queue-list:not(.is-single)::-webkit-scrollbar { width: 6px; }
.ui-notice-queue-list:not(.is-single)::-webkit-scrollbar-thumb { background: var(--border-medium, var(--border-subtle)); border-radius: 3px; }
.ui-notice-queue-list:not(.is-single) .ui-notice-queue-row + .ui-notice-queue-row { border-top: 1px solid var(--border-subtle); }

.ui-notice-plan-settings { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border-subtle); display: flex; flex-direction: column; gap: 10px; }
.ui-notice-plan-fields { display: flex; gap: 12px; flex-wrap: wrap; }
.ui-notice-plan-fields > label { display: flex; align-items: center; gap: 8px; font-size: 11px; }
.ui-notice-plan-fields .input-shell { width: 72px; }

/* ── 追加消息卡：单条抬头即正文 ─────────────────────────────────────────────
   单条时不显示列表，抬头就是「一条追加消息等待中：<正文>」，三个动作按钮挂在
   抬头右侧（与「AI 询问」卡头同一行结构）；多条时抬头只有一句计数 + 展开箭头。 */
.composer-notice-slot[data-notice-kind="queue"] .ui-notice-summary.is-static .ui-notice-actions { margin-left: 2px; }
.composer-notice-slot[data-notice-kind="queue"] .ui-notice-preview { flex: 1; min-width: 0; }
/* 单条形态没有汇总头：那一条消息本身就是卡片内容（一行里依次是 呼吸灯 → 「一条追加
   消息等待中：」→ 附件 → 正文 → 三个按钮），所以整块 `.ui-notice-heading` 不渲染。 */
.ui-notice.is-inline:has(.ui-notice-queue-list.is-single) > .ui-notice-heading { display: none; }
.ui-notice-queue-list.is-single { border-top: 0; }
/* 单条抬头：点/圆环 → 8px → 「一条追加消息等待中：」 → 4px → 正文 → 按钮。
   正文只吃按钮左侧剩下的宽度，超出就省略号（title 里挂完整内容）。
   呼吸环外扩到 -3px，所以圆点旁边必须留出真正的间距，否则环会压到字上。 */
.ui-notice-queue-single-head { display: flex; align-items: center; gap: 0; min-width: 0; overflow: hidden; white-space: nowrap; font-size: 12.5px; font-weight: 400; color: var(--text-secondary); }
.ui-notice-queue-single-head .ui-notice-queue-single-label { flex: 0 0 auto; margin-right: 4px; font-size: 12.5px; font-weight: 600; color: var(--text-primary); }
.ui-notice-queue-single-head .ui-notice-queue-single-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); }


/* ---- ../../components/ui/attachment.css ---- */
/* ==========================================================================
   Attachment — composer attachment card.
   Geometry copied from views/Chat/styles/composer-attachment-card.css:
     48px min height, 12px radius, 30px icon chip, 36px image preview.
   Images always show a real thumbnail; a missing one shows the image glyph.
   ========================================================================== */

.ui-attachment {
  position: relative;
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  border: 0;
  border-radius: 12px;
  color: var(--text-primary);
  background: var(--surface-action-bg);
  box-shadow: 0 1px 2px color-mix(in srgb, var(--text-primary) 7%, transparent);
  box-sizing: border-box;
  transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
}

.ui-attachment:hover {
  background: var(--surface-action-hover-bg);
  box-shadow: 0 2px 7px color-mix(in srgb, var(--text-primary) 10%, transparent);
}

.ui-attachment.is-row {
  width: min(260px, 100%);
  min-height: 48px;
  padding: 7px 8px 7px 9px;
}

/* Icon chip: 30px rounded square, accent tint. */
.ui-attachment-face {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--accent-primary);
  cursor: pointer;
}

.ui-attachment.is-row .ui-attachment-face {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: color-mix(in srgb, var(--accent-primary) 10%, transparent);
}

.ui-attachment-face:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 1px;
}

/* Image preview: 36px square, cover-cropped, zoom cursor. */
.ui-attachment.is-row.is-image .ui-attachment-face {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--surface-inset-bg);
  cursor: zoom-in;
}

.ui-attachment.is-row.is-image .ui-attachment-face img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ui-attachment-glyph { display: inline-flex; }

/* Lazy image preview swapped in through the `preview` slot: same 36px square
   the icon face occupies, so the row does not resize when the bitmap lands. */
.ui-attachment.is-row .ui-attachment-image {
  position: relative;
  flex: 0 0 36px;
  width: 36px;
  height: 36px;
  padding: 0;
  overflow: hidden;
  border-radius: 8px;
  background: var(--surface-inset-bg);
  border: 0;
  cursor: zoom-in;
}

.ui-attachment.is-row .ui-attachment-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ui-attachment.is-row .ui-attachment-image svg {
  position: absolute;
  inset: 0;
  margin: auto;
  color: var(--text-tertiary);
}

/* Kind tints: only the glyph colour changes, the chip stays neutral. */
.ui-attachment.is-image .ui-attachment-glyph { color: var(--accent-primary); }
.ui-attachment.is-directory .ui-attachment-glyph { color: var(--warning-text); }
.ui-attachment.is-code .ui-attachment-glyph { color: var(--success-text); }
.ui-attachment.is-archive .ui-attachment-glyph { color: color-mix(in srgb, var(--accent-primary) 55%, var(--warning-text)); }
.ui-attachment.is-json .ui-attachment-glyph { color: color-mix(in srgb, var(--warning-text) 70%, var(--text-primary)); }
.ui-attachment.is-document .ui-attachment-glyph { color: var(--status-danger-text); }
.ui-attachment.is-text .ui-attachment-glyph { color: var(--text-secondary); }

.ui-attachment-meta {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1 1 auto;
  min-width: 0;
  padding: 1px 0;
}

.ui-attachment-name {
  font-size: 12px;
  font-weight: 550;
  line-height: 1.25;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ui-attachment-meta small {
  font-size: 11px;
  line-height: 1.2;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ui-attachment-retry {
  padding: 0;
  border: 0;
  background: transparent;
  font: inherit;
  font-size: 11px;
  text-align: left;
  color: var(--text-error, var(--text-secondary));
  cursor: pointer;
}

.ui-attachment-retry:hover { text-decoration: underline; }

/* Remove: quiet at rest, red only on hover. Matches the toast close glyph:
   same box, same hover fill, same danger ink. Nothing is visible until the
   pointer arrives, so a card full of attachments stays calm. */
.ui-attachment-remove.btn,
.ui-attachment-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 24px;
  width: 24px;
  min-width: 24px;
  height: 24px;
  padding: 0;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--text-tertiary);
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.ui-attachment-remove:hover:not(:disabled) {
  color: var(--status-danger-text);
  background: color-mix(in srgb, var(--danger-text) 12%, transparent);
}

/* ── tile shape ──────────────────────────────────────────────────────────── */
.ui-attachment.is-tile { border-radius: 10px; overflow: visible; }
.ui-attachment.is-tile .ui-attachment-face {
  width: 100%;
  height: 100%;
  border-radius: 10px;
  overflow: hidden;
  background: var(--surface-inset-bg);
  cursor: zoom-in;
}
.ui-attachment.is-tile .ui-attachment-face img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ui-attachment.is-tile .ui-attachment-remove {
  position: absolute;
  top: -5px;
  right: -5px;
  border-radius: 999px;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  color: var(--text-tertiary);
  opacity: 0;
  transition: opacity var(--transition-fast), color var(--transition-fast),
    background-color var(--transition-fast), border-color var(--transition-fast);
}
.ui-attachment.is-tile:hover .ui-attachment-remove,
.ui-attachment.is-tile:focus-within .ui-attachment-remove { opacity: 1; }

.ui-attachment.is-tile .ui-attachment-remove:hover:not(:disabled) {
  color: var(--status-danger-text);
  background: color-mix(in srgb, var(--danger-text) 12%, var(--bg-card));
  border-color: color-mix(in srgb, var(--danger-text) 30%, var(--border-subtle));
}

@media (hover: none) {
  .ui-attachment.is-tile .ui-attachment-remove { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .ui-attachment,
  .ui-attachment-remove { transition: none; }
}


/* ---- ../../components/ui/progress-ring.css ---- */
/* ==========================================================================
   ProgressRing — composer context-usage control.
   Small ring + percentage label; the panel opens upward and lists segments.
   ========================================================================== */

.ui-ring-control {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

/* 命中区 32px 圆形，与产品里 .context-usage-ring-hit 同尺寸。
   环本身仍是 20px，只有点击区和 hover 底色变大。

   选择器带 .btn 是为了拿到 (0,2,0) 的特异性：本组件用的是
   `Button variant="bare"`，而 `.btn.btn-bare` 会重置 padding / height /
   border-radius，单类选择器压不过它，hover 出来就是方角块。 */
/* 命中区 32px 圆形，与产品里 .context-usage-ring-hit 同尺寸；环本身仍是 20px，
   只有点击区与 hover 底色变大。

   选择器带 .btn 是为了拿到 (0,2,0) 特异性：本组件用 Button variant="bare"，
   必须压过 .btn 基础类注入的 padding / border-radius，否则 hover 是方角块。 */
.ui-ring-trigger.btn {
  width: 32px;
  height: 32px;
  min-width: 32px;
  padding: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--text-tertiary);
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

/* Hover 与展开都只是圆形命中区里的一层浅底，和产品里同一种处理。 */
.ui-ring-trigger.btn:hover:not(:disabled) {
  color: var(--text-secondary);
  background: var(--button-hover-bg);
}

.ui-ring-trigger.btn.is-open,
.ui-ring-trigger.btn.is-open:hover:not(:disabled) {
  color: var(--accent-primary);
  background: var(--bg-selected);
}

.ui-ring-trigger.btn:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 1px;
}
.ui-ring {
  width: 20px;
  height: 20px;
  transform: rotate(-90deg);
}

.ui-ring-track {
  fill: none;
  stroke: color-mix(in srgb, var(--text-primary) 14%, transparent);
  stroke-width: 2.4;
}

.ui-ring-fill {
  fill: none;
  stroke: currentColor;
  stroke-width: 2.4;
  stroke-linecap: round;
  transition: stroke-dasharray var(--transition-base), stroke var(--transition-base);
}

.ui-ring-control.is-warning .ui-ring-fill,
.ui-ring-control.is-warning .ui-ring-percent { stroke: var(--warning-text); color: var(--status-warning-text); }
.ui-ring-control.is-danger .ui-ring-fill,
.ui-ring-control.is-danger .ui-ring-percent { stroke: var(--danger-text); color: var(--status-danger-text); }

.ui-ring-control.is-busy .ui-ring { animation: ui-ring-pulse 1.4s ease-in-out infinite; }

.ui-ring-percent {
  font-size: 10.5px;
  font-variant-numeric: tabular-nums;
  color: var(--text-tertiary);
  white-space: nowrap;
  min-width: 30px;
}

/* Opens upward: the control sits at the bottom of the composer. */
.ui-ring-panel {
  --context-system: #94a3b8;
  --context-tools: #5141ed;
  --context-messages: #6c63f5;
  position: absolute;
  z-index: 40;
  bottom: calc(100% + 8px);
  left: 0;
  width: min(320px, calc(100vw - 32px));
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 16px;
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  background: rgb(from var(--popover-bg) r g b / 1);
  box-shadow: var(--popover-shadow);
  color: var(--text-primary);
  font-size: 12px;
}

.ui-ring-panel header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
  line-height: 18px;
}

.ui-ring-panel header > span { color: var(--text-secondary); }
.ui-ring-panel header b { margin-left: 8px; color: var(--text-primary); font-weight: 600; }

.ui-ring-panel header strong {
  font-size: 12px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  color: var(--text-primary);
  white-space: nowrap;
}

.ui-ring-meter {
  display: flex;
  height: 6px;
  border-radius: 999px;
  overflow: hidden;
  background: color-mix(in srgb, var(--text-primary) 10%, transparent);
}

.ui-ring-meter i { display: block; height: 100%; }
.ui-ring-meter .is-used { background: var(--context-messages); }
.ui-ring-meter .is-system { background: var(--context-system); }
.ui-ring-meter .is-tools { background: var(--context-tools); }
.ui-ring-meter .is-messages { background: var(--context-messages); }
.ui-ring-meter .is-remaining { background: transparent; }

.ui-ring-legend {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 16px 0 0;
  padding: 0;
  list-style: none;
}

.ui-ring-legend li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  line-height: 18px;
  color: var(--text-secondary);
}

.ui-ring-legend li i {
  width: 9px;
  height: 9px;
  border-radius: 3px;
  flex: 0 0 auto;
}

.ui-ring-legend li.is-system i { background: var(--context-system); }
.ui-ring-legend li.is-tools i { background: var(--context-tools); }
.ui-ring-legend li.is-messages i { background: var(--context-messages); }
.ui-ring-legend li.is-used i { background: var(--accent-primary); }
.ui-ring-legend li.is-remaining i { background: color-mix(in srgb, var(--text-primary) 10%, var(--bg-canvas)); }
.ui-ring-legend li span { flex: 1; min-width: 0; }
.ui-ring-legend li strong { font-size: 12px; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--text-primary); }

@keyframes ui-ring-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

@media (prefers-reduced-motion: reduce) {
  .ui-ring-control.is-busy .ui-ring { animation: none; }
  .ui-ring-fill { transition: none; }
}


/* ---- ../../components/ui/spinner.css ---- */
/* ==========================================================================
   Spinner — the shared rotating "working" glyph.
   One keyframes set for the whole app; the only per-use adjustment is size and
   the inherited colour (currentColor).
   ========================================================================== */

.ui-spinner {
  display: inline-block;
  flex: 0 0 auto;
  vertical-align: -2px;
  color: inherit;
  animation: ui-spinner-rotate 1s linear infinite;
}

/* Inside a text run the glyph needs a little breathing room; inside a flex row
   the row's own gap provides it, so scoped overrides set margin:0. */
.ui-spinner.is-inline { margin-left: 6px; }

@keyframes ui-spinner-rotate {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .ui-spinner { animation: none; }
}

/* StepSpinner：TaskStepList 运行态同款（主色淡底圆 + 旋转虚线弧）。 */
.ui-step-spinner {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--accent-subtle);
  color: var(--accent-primary);
  animation: task-step-spin 1s linear infinite;
}

@keyframes task-step-spin {
  100% { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .ui-step-spinner { animation: none; }
}


/* ---- ../../components/ui/compaction-progress.css ---- */
/* ==========================================================================
   CompactionProgress — context compaction strip above the composer.
   A single status line plus an optional determinate track. No header, no
   collapse: this is not a NoticePanel.
   ========================================================================== */

.ui-compaction {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 6px 10px;
  border-radius: 8px;
  background: var(--surface-inset-bg);
  font-size: 12px;
  color: var(--text-secondary);
}

.ui-compaction-copy {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
}

.ui-compaction-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
}

.ui-compaction-label { color: var(--text-primary); }

/* The completed tick reuses the tool-status circle verbatim: a filled accent
   disc with a white 2.8-stroke check. Without the disc the bare green glyph
   reads as a different icon family from the tool rows. */
.ui-compaction.is-completed .ui-compaction-icon {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1px solid transparent;
  background: var(--accent-primary, #6366f1);
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(99, 102, 241, 0.4);
}

.ui-compaction.is-completed .ui-compaction-icon svg {
  width: 11px;
  height: 11px;
  stroke: #ffffff;
  stroke-width: 2.8;
}

.ui-compaction.is-running .ui-compaction-icon { color: var(--accent-primary); }
.ui-compaction.is-interrupted .ui-compaction-icon { color: var(--status-warning-text); }
.ui-compaction.is-failed .ui-compaction-icon { color: var(--status-danger-text); }

/* Fixed-length track instead of a full-width bar: the strip shares its row with
   the label and the token delta, so a flex-grown bar dominated the line. */
.ui-compaction-track {
  flex: 0 0 auto;
  width: clamp(96px, 22%, 180px);
  height: 4px;
  border-radius: 999px;
  overflow: hidden;
  background: color-mix(in srgb, var(--text-primary) 12%, transparent);
}

.ui-compaction-track > span {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: var(--accent-primary);
  transition: width var(--transition-base);
}

/* No percentage yet (a running compaction before the backend reports one):
   the same track sweeps instead of standing empty, then hands over to the
   determinate fill as soon as a value arrives. */
.ui-compaction-track.is-indeterminate > span {
  width: 38%;
  animation: ui-compaction-sweep 1.15s ease-in-out infinite;
}

@keyframes ui-compaction-sweep {
  from { transform: translateX(-100%); }
  to { transform: translateX(265%); }
}

/* The bar stays accent blue in every state, including completed. */
.ui-compaction.is-completed .ui-compaction-track > span { background: var(--accent-primary); }

.ui-compaction-percent {
  flex: 0 0 auto;
  font-size: 11px;
  font-variant-numeric: tabular-nums;
  color: var(--text-tertiary);
}

.ui-compaction-detail {
  flex: 0 0 auto;
  font-size: 11px;
  color: var(--text-tertiary);
}

/* --- 行内形态：时间线里的一行，与「执行指令」工具组行同高、同缩进 --------------
   去掉外框与孤立卡片感：没有底色、没有进度轨，只留图标 + 标签 + 明细 + 百分比
   文字。这一行的几何与字色必须和 `.agent-tool-group-summary` 逐项相同，否则
   压缩行会像个外来户：左边多缩进 8px、标签更黑更粗、行更高（见
   conversation-surfaces.css 里工具组行的实际生效值：padding 0 / gap 7px /
   min-height 24px / font-size 12.5px / color text-secondary / 标签 weight 500）。 */
.ui-compaction.is-row {
  gap: 7px;
  width: fit-content;
  max-width: 100%;
  min-height: 24px;
  padding: 0;
  border-radius: 6px;
  background: transparent;
  font-size: 12.5px;
  color: var(--text-secondary);
}

.ui-compaction.is-row .ui-compaction-copy { gap: 7px; }

/* 标签跟着整行取色（不用 --text-primary），这样「已完成」的行和最下面的
   工具行一样是次级字色，只有进行中那行才吃强调色。 */
.ui-compaction.is-row .ui-compaction-label { color: inherit; font-weight: 500; }
.ui-compaction.is-row.is-running { color: var(--accent-primary); }

.ui-compaction.is-row .ui-compaction-detail,
.ui-compaction.is-row .ui-compaction-percent { font-size: 10px; }

@media (prefers-reduced-motion: reduce) {
  .ui-compaction-track > span { transition: none; }
  .ui-compaction-track.is-indeterminate > span { animation: none; width: 100%; opacity: 0.6; }
}


/* ---- ../../components/ui/usage-metrics.css ---- */
/* ==========================================================================
   UsageMetrics — the composer's one-line metrics strip.
   Geometry from conversation-theme.css: hairline top divider, 10px type,
   baseline-aligned label + bold value, 9px horizontal padding per item.
   ========================================================================== */

.ui-usage {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  gap: 0;
  min-width: 0;
  margin-top: 7px;
  padding-top: 7px;
  border-top: 1px solid var(--composer-divider);
  color: var(--composer-muted);
  font-size: 10px;
  line-height: 1.2;
  white-space: nowrap;
}

.ui-usage-item {
  position: relative;
  display: inline-flex;
  align-items: baseline;
  gap: 4px;
  min-width: 0;
  padding: 0 9px;
  border: 0;
  color: inherit;
  background: transparent;
  font: inherit;
}

/* 项目之间的竖分割线（伪元素，最后一项自然没有尾巴） */
.ui-usage-item + .ui-usage-item::before,
.ui-usage-item + .ui-usage-action::before { content: ""; position: absolute; left: 0; top: 50%; width: 1px; height: 9px; margin-top: -4.5px; background: var(--composer-divider); }
.ui-usage-item b {
  color: var(--text-primary);
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.ui-usage-label {
  color: var(--composer-muted);
  font-weight: 400;
}

.ui-usage-action {
  cursor: pointer;
  border-radius: 5px;
  transition: background-color var(--transition-fast);
}

.ui-usage-action:hover:not(:disabled) {
  background: var(--button-hover-bg);
  color: var(--text-primary);
}

.ui-usage-action:disabled { cursor: default; }

.ui-usage-action:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 1px;
}

.ui-usage-spin { animation: ui-usage-rotate 0.9s linear infinite; }

@keyframes ui-usage-rotate {
  to { transform: rotate(360deg); }
}

@media (max-width: 480px) {
  .ui-usage { justify-content: flex-start; }
  .ui-usage-item { padding: 0 5px; }
}

@media (prefers-reduced-motion: reduce) {
  .ui-usage-spin { animation: none; }
  .ui-usage-action { transition: none; }
}


/* ---- ../../components/ui/file-preview-panel.css ---- */
/* ==========================================================================
   FilePreviewPanel — read-only file preview shell.
   Header (name + tools) / modes / search / body slot / path footer.
   ========================================================================== */

.ui-preview {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* Docked variant: the panel fills a pane that is flush with its container, so
   the container's own rounding owns the outer corners and this surface is
   squared off. A rounded edge at the seam reads as a stray extra corner. */
.ui-preview.is-docked {
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.ui-preview-header {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-bottom: 1px solid var(--border-subtle);
}

.ui-preview-title {
  display: flex;
  flex-direction: column;
  gap: 1px;
  flex: 1;
  min-width: 0;
}

.ui-preview-title strong {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ui-preview-title small {
  font-size: 10px;
  color: var(--text-tertiary);
}

.ui-preview-tools {
  display: flex;
  align-items: center;
  gap: 2px;
  flex: 0 0 auto;
}

/* Tool buttons are library Buttons (variant="subtle" size="xs"). No size or
   hover rules here — .btn-xs + .btn-subtle own them. */

/* Modes row */
.ui-preview-modes {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 10px;
  border-bottom: 1px solid var(--border-subtle);
}

.ui-preview-modes > div {
  display: inline-flex;
  gap: 2px;
  padding: 2px;
  border-radius: 8px;
  background: var(--input-bg-sunken);
}

/* Mode buttons are library Buttons too; only the active fill is local. */
.ui-preview-mode.is-active {
  background: var(--bg-surface);
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
}

.ui-preview-counts {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  font: 11.5px/1 var(--font-mono);
  font-variant-numeric: tabular-nums;
}

.ui-preview-counts b { color: var(--status-success-text); font-weight: 600; }
.ui-preview-counts i { color: var(--status-danger-text); font-style: normal; font-weight: 600; }
.ui-preview-counts small { color: var(--text-tertiary); font-size: 10px; }

/* Search row */
.ui-preview-search {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-bottom: 1px solid var(--border-subtle);
}

.ui-preview-search-input {
  flex: 1;
  min-width: 0;
  height: 26px;
  padding: 0 8px;
  border: 1px solid var(--border-subtle);
  border-radius: 7px;
  background: var(--input-bg-sunken);
  color: var(--input-text);
  font: inherit;
  font-size: 11.5px;
}

.ui-preview-search-input:focus {
  outline: none;
  border-color: var(--accent-border);
}

.ui-preview-search > span {
  flex: 0 0 auto;
  font-size: 10.5px;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* Body slot */
.ui-preview-content {
  flex: 1;
  min-height: 0;
  overflow: auto;
  scrollbar-width: thin;
  /* Chromium 下不指色就是默认浅色滚动条，暗色主题里非常刺眼。 */
  scrollbar-color: var(--scrollbar-thumb) transparent;
}
.ui-preview-content:has(> .ui-file-diff) { display: flex; overflow: hidden; scrollbar-gutter: auto; }

/* Path footer */
.ui-preview-path {
  flex: 0 0 auto;
  padding: 6px 10px;
  border-top: 1px solid var(--border-subtle);
  font: 10.5px/1.4 var(--font-mono);
  color: var(--text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


/* ---- ../../components/ui/file-diff-view.css ---- */
.ui-file-diff {
  flex: 1;
  min-width: 0;
  min-height: 0;
  padding-block: 8px;
  overflow: auto;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  color: var(--code-foreground);
  background: var(--code-background);
  font: 12px/22px var(--font-mono);
  tab-size: 2;
  white-space: pre;
}
.ui-file-diff-rows { min-width: max-content; }
.ui-file-diff-row { display: flex; min-height: 22px; }
.ui-file-diff-row.is-added { background: var(--code-diff-added-bg); }
.ui-file-diff-row.is-removed { background: var(--code-diff-removed-bg); }
.ui-file-diff-row.is-meta { color: var(--text-tertiary); background: var(--bg-hover); }
.ui-file-diff-number { flex: 0 0 42px; width: 42px; padding-inline: 6px; color: var(--code-line-number); text-align: right; user-select: none; }
.ui-file-diff-marker { flex: 0 0 20px; width: 20px; text-align: center; user-select: none; }
.ui-file-diff-row.is-added .ui-file-diff-marker { color: var(--code-diff-added-text); }
.ui-file-diff-row.is-removed .ui-file-diff-marker { color: var(--code-diff-removed-text); }
.ui-file-diff-row code { flex: 1; padding-right: 16px; font: inherit; }
.ui-file-diff-notice { margin: 0; padding: 12px; color: var(--text-secondary); white-space: normal; }


/* ---- ../../components/ui/file-change-card.css ---- */
/* ==========================================================================
   FileChangeCard — the settled file-change card after an assistant reply.
   Carries both the original Card shell and chatAppearance refinements.
   Keep the surface in Card; only file-list geometry belongs here.
   Colors: --change-added / --change-removed aliased to success / danger.
   ========================================================================== */

.ui-file-changes {
  --change-added: var(--success-text);
  --change-removed: var(--danger-text);

  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 760px;
  margin: 12px auto 0;
  color: var(--text-primary);
  container-type: inline-size;
}

.ui-file-changes > header {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 56px;
  padding: 14px 18px;
  border-bottom: 1px solid var(--divider-color);
}

.ui-file-changes-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 36px;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: var(--accent-subtle);
  color: var(--accent-primary);
}

.ui-file-changes-heading {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4px 12px;
  min-width: 0;
}

.ui-file-changes-heading > b {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
}

.ui-file-changes-total,
.ui-file-changes-stats {
  display: inline-flex;
  flex: 0 0 auto;
  gap: 5px;
  font-size: 12px;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.ui-file-changes em { color: var(--change-added); font-style: normal; }
.ui-file-changes i { color: var(--change-removed); font-style: normal; }

.ui-file-changes-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 0 0 auto;
}

/* Restore the historical inset rows. Match the bare Button specificity so
   its reset cannot replace the row typography, alignment or hover fill. */
.ui-file-changes-files { padding: 6px 8px; }

.ui-file-changes-file.btn.btn-bare {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  min-height: 28px;
  margin: 2px 0;
  padding: 6px 10px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: var(--text-secondary);
  font: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.ui-file-changes-file > span:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ui-file-changes-file.is-deleted > span:first-child { text-decoration: line-through; }
.ui-file-changes-file.btn.btn-bare:hover { background: var(--bg-hover); color: var(--text-primary); }
.ui-file-changes-file.btn.btn-bare:active { background: var(--bg-selected); }

.ui-file-changes-file:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: -2px;
}

/* Expand toggle uses the library Button; only the offset is local. */
.ui-file-changes-expand.btn {
  align-self: flex-start;
  margin: 6px 12px 12px;
}

/* A split pane can be narrow even on a wide desktop window. */
@container (max-width: 480px) {
  .ui-file-changes > header { flex-wrap: wrap; padding: 12px; }
  .ui-file-changes-heading { flex-basis: calc(100% - 44px); }
  .ui-file-changes-actions { margin-left: 44px; }
  .ui-file-changes-file.btn.btn-bare { gap: 8px; }
}

@media (prefers-reduced-motion: reduce) {
  .ui-file-changes-file.btn.btn-bare { transition: none; }
}


/* ---- ../../components/ui/file-change-notice.css ---- */
/* ==========================================================================
   FileChangeNotice — 文件改动 row above the composer.
   只由本组件拥有；共享的 NoticePanel 不受影响。

   布局：收起时是一行药丸；展开时药丸变成一张卡片，文件列表直接在卡片里
   往下铺开（宽度和药丸一致，不会把整行撑满）。
   交互：点击行切换展开/收起，Escape 收起；没有 hover 展开，点击外侧也不收起
   （点击外侧收起属于弹窗语义，这一行是常驻的布局元素）。

   不透明：整张卡（收起和展开）都用 `--notice-fill` 盖一层去透明度的实色，
   `var(--bg-card)` 在亮色是 0.85 的白，直接拿它当底色会让上方对话文字透出来。
   `--notice-fill` 由 notice-panel.css 定义成
   `color-mix(in srgb, var(--bg-card) 100%, var(--bg-canvas))`；
   本组件也可能被单独渲染（不在 `.ui-notice` 里），所以下面自己也声明一次。
   -------------------------------------------------------------------------- */

/* 外壳容器：收起是一行药丸，展开是同一列变成卡片。
   `--notice-fill` 在这里声明，药丸和展开后的外壳都继承同一枚去 alpha 的填充。 */
.ui-file-notice {
  --notice-fill: color-mix(in srgb, var(--bg-card) 100%, var(--bg-canvas));
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.ui-file-notice-row {
  display: flex;
  width: 100%;
  justify-content: center;
}

/* 停靠区里的版本：上下间距由停靠区的 8px 节奏（gap）负责，行本身不再自带外边距。 */
.ui-file-notice.composer-file-notice { margin-bottom: 0; }

/* 收起状态：紧凑药丸，展开前后宽度不变，避免行本身跳动。 */
.ui-file-notice-summary.btn.btn-bare {
  display: flex;
  align-items: center;
  gap: 8px;
  width: min(34%, 280px);
  min-width: 220px;
  min-height: 36px;
  padding: 5px 12px;
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  /* 与 NoticePanel 同一套不透明填充：垫底 `--bg-canvas` + 盖面 `--notice-fill`。
     `background` 简写会把这两层一起重置，所以下面只用 `background-color`
     做 hover 变色，否则 hover 时底又会透出来。 */
  background-color: var(--bg-canvas);
  background-image: linear-gradient(var(--notice-fill), var(--notice-fill));
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
  font: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
  transition: background-color var(--transition-fast), box-shadow var(--transition-fast);
}

.ui-file-notice-summary.btn.btn-bare:hover:not(:disabled) {
  background-color: var(--button-hover-bg, var(--bg-hover));
}

.ui-file-notice-summary.btn.btn-bare:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 2px;
}

.ui-file-notice-icon {
  display: inline-flex;
  flex: 0 0 15px;
  width: 15px;
  height: 15px;
  color: var(--text-secondary);
}

.ui-file-notice-icon svg { width: 15px; height: 15px; stroke-width: 1.7; }

.ui-file-notice-label {
  flex: 0 0 auto;
  font-weight: 500;
  white-space: nowrap;
}

.ui-file-notice-diff {
  flex: 0 0 auto;
  display: inline-flex;
  gap: 6px;
  font-variant-numeric: tabular-nums;
}

.ui-file-notice-diff em { font-style: normal; color: var(--status-success-text); }
.ui-file-notice-diff i { font-style: normal; color: var(--status-danger-text); }

.ui-file-notice-count {
  flex: 0 0 auto;
  margin-left: auto;
  color: var(--text-tertiary);
  font-size: 11px;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.ui-file-notice-chevron {
  flex: 0 0 auto;
  margin-left: 6px;
  color: var(--text-tertiary);
  transition: transform 0.15s ease;
}

/* 列表向下展开，所以收起时的右箭头展开后转成向下（ChevronRight → ChevronDown）。 */
.ui-file-notice.is-expanded .ui-file-notice-chevron { transform: rotate(90deg); }

/* 展开态：药丸行变成整张卡片。宽度仍是同一枚药丸那档（min(34%,280px)），
   所以展开的一瞬间宽度不变，不会横向跳一下；只是多出一块向下铺开的列表。 */
.ui-file-notice.is-expanded > .ui-file-notice-row {
  display: flex;
  flex-direction: column;
  width: min(34%, 280px);
  min-width: 220px;
  max-height: min(380px, 50vh);
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  background-color: var(--bg-canvas);
  background-image: linear-gradient(var(--notice-fill), var(--notice-fill));
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 展开时额头交出自己的圆角/描边/底色：外壳已经是卡片，别套两道边。 */
html[data-theme] .ui-file-notice.is-expanded > .ui-file-notice-row > .ui-file-notice-summary.btn.btn-bare {
  width: 100%;
  min-width: 0;
  flex: 0 0 auto;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
}

/* hover 时仍然只换 background-color：上面那条把底图（不透明盖层）清掉了，
   所以这里给一个不透明的 hover 色，别让 hover 一下又透出对话文字。 */
html[data-theme] .ui-file-notice.is-expanded > .ui-file-notice-row > .ui-file-notice-summary.btn.btn-bare:hover:not(:disabled) {
  border-radius: 0;
  background-color: var(--button-hover-bg, var(--bg-hover));
  background-image: none;
  border-color: transparent;
}

/* 展开后的文件列表：卡片内部的一块，向下撑开而不是盖住上方对话。
   底色透明 —— 不透明的那一层是上面的卡片壳，这里再叠一层只会出两道色差。 */
.ui-file-notice-body {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 8px 10px 10px;
  border: 0;
  border-top: 1px solid var(--border-subtle);
  border-radius: 0;
  background-color: transparent;
  color: var(--text-primary);
  box-shadow: none;
  overflow: auto;
  overscroll-behavior: contain;
}

/* 文件行沿用共享通知列表的样式。 */
.ui-file-notice-body .ui-notice-file-list { gap: 2px; }

/* 窄窗口：占满宽度，路径更好读。 */
@media (max-width: 720px) {
  .ui-file-notice-summary.btn.btn-bare,
  .ui-file-notice.is-expanded > .ui-file-notice-row,
  html[data-theme] .ui-file-notice.is-expanded > .ui-file-notice-row,
  html[data-theme] .ui-file-notice.is-expanded > .ui-file-notice-row > .ui-file-notice-summary.btn.btn-bare {
    width: 100%;
    min-width: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ui-file-notice-chevron,
  .ui-file-notice-summary.btn.btn-bare { transition: none; }
}


/* ---- ../../components/ui/context-menu.css ---- */
.context-menu {
  position: fixed;
  z-index: 999999;
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 208px;
  max-width: calc(100vw - 16px);
  padding: 6px;
  border: 0;
  border-radius: var(--radius-lg);
  background: var(--popover-bg);
  color: var(--text-primary);
  box-shadow: var(--popover-shadow);
  animation: context-menu-appear .12s ease-out;
}
.context-menu button {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 34px;
  padding: 7px 10px;
  border: 0;
  border-radius: var(--radius-base);
  background: transparent;
  color: inherit;
  font: inherit;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}
.context-menu button svg { width: 15px; height: 15px; color: var(--text-secondary); }
.context-menu button .context-menu-check { margin-left: auto; }
.context-menu button:hover:not(:disabled),
.context-menu button:focus-visible { background: var(--popover-item-hover); outline: none; }
.context-menu button:disabled { color: var(--text-tertiary); cursor: default; }
/* 破坏性项（删除 / 移除）走危险色：菜单里最容易被误点的常是最后一项，
   颜色先说话，点下去还有各自的二次确认。 */
.context-menu button.is-danger,
.context-menu button.is-danger svg { color: var(--status-danger-text); }
@keyframes context-menu-appear { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .context-menu { animation: none; } }


/* ---- ../../components/ui/modal.css ---- */
/* ==========================================================================
   Modal - 通用弹窗壳（遮罩 / 卡片 / 标题栏 / 底部按钮）
   ========================================================================== */

.ui-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: var(--overlay-bg);
  backdrop-filter: blur(4px);
  animation: uiModalFadeIn 0.16s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes uiModalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.ui-modal {
  display: flex;
  flex-direction: column;
  width: min(560px, 94vw);
  max-height: min(78vh, 720px);
  overflow: hidden;
  background: var(--popover-bg);
  border: var(--popover-border);
  border-radius: 18px;
  box-shadow: var(--popover-shadow), inset 0 1px 1px 0 rgba(255, 255, 255, 0.16);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  animation: uiModalScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.ui-modal-sm { width: min(420px, 94vw); }

@keyframes uiModalScaleIn {
  from { opacity: 0; transform: scale(0.96) translateY(6px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.ui-modal-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 18px 18px 12px;
  flex: none;
}

.ui-modal-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex: none;
  border-radius: 10px;
  background: var(--surface-inset-bg);
  color: var(--text-secondary);
}

.ui-modal-icon.is-danger {
  background: var(--status-danger-bg);
  color: var(--status-danger-text);
}

.ui-modal-headings {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
  min-width: 0;
}

.ui-modal-title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text-primary);
}

.ui-modal-description {
  margin: 0;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--text-tertiary);
  overflow-wrap: anywhere;
}

.ui-modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  flex: none;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 8px;
  background: transparent;
  color: var(--text-tertiary);
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.ui-modal-close:hover:not(:disabled) {
  background: var(--bg-hover);
  color: var(--text-primary);
}

.ui-modal-close:disabled { opacity: 0.45; cursor: not-allowed; }

.ui-modal-content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0 18px 4px;
}

.ui-modal-content:last-child { padding-bottom: 18px; }

.ui-modal-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  flex: none;
  padding: 14px 18px 18px;
}

.ui-modal :focus-visible {
  outline: 2px solid rgba(82, 119, 220, 0.36);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  .ui-modal-overlay,
  .ui-modal { animation: none; }
}


/* ---- ../../components/ui/tooltip.css ---- */
.ui-tooltip-trigger { display: inline-flex; align-items: center; }
.ui-tooltip-trigger:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 3px; border-radius: 4px; }
.ui-tooltip {
  position: fixed;
  z-index: 10000;
  box-sizing: border-box;
  max-width: 320px;
  padding: 7px 10px;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  background: var(--popover-bg);
  color: var(--text-primary);
  box-shadow: var(--popover-shadow);
  font-family: var(--font-sans);
  font-size: 11.5px;
  line-height: 1.6;
  font-weight: 400;
  white-space: pre-line;
  overflow-wrap: anywhere;
  pointer-events: none;
}


/* ---- ../../components/ui/task-step-list.css ---- */
/* ==========================================================================
   TaskStepList: vertical task checklist extracted from card-showcase.html.
   Strict 20x20px circle; done = solid ring + check, running = spinning dash
   arc, pending = a single hollow ring with no inner circle.
   ========================================================================== */

.task-step-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.task-step-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 10px;
  border-radius: 12px;
  font-size: 13.5px;
  color: var(--text-primary);
  transition: background-color var(--transition-base);
  user-select: none;
  min-width: 0;
}

/* 只有真的可点（传了 onStepClick）的行才给悬停底色。
   对话页里的步骤清单是一张纯展示清单，鼠标划过一行就亮起一块底色，看着像
   「这里可以点」，用户点下去却什么也没有发生（用户反馈：hover 为什么变色）。 */
html[data-theme] .task-step-row.is-clickable:hover {
  background: var(--chrome-hover);
}

html[data-theme] .task-step-row.is-clickable {
  cursor: pointer;
}

/* Compact rows: the vertical squeeze used by the chat task timeline. */
.task-step-list.is-compact {
  gap: 2px;
}

.task-step-list.is-compact .task-step-row {
  padding: 3px 8px;
  font-size: 12.5px;
}

/* Status circle: strict single 20x20 geometry. */
.task-step-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base);
}

.task-step-icon svg {
  display: block;
  fill: none;
  stroke: currentColor;
}

/* done: filled ring with a check. */
.task-step-icon.done {
  background: var(--accent-primary);
  color: var(--accent-text);
  box-shadow: var(--accent-glow);
}

.task-step-icon.done svg {
  width: 12px;
  height: 12px;
  stroke-width: 2.6;
}

/* running: spinning dash arc on a subtle accent fill. */
.task-step-icon.running {
  background: var(--accent-subtle);
  color: var(--accent-primary);
}

.task-step-icon.running svg {
  width: 13px;
  height: 13px;
  animation: task-step-spin 1s linear infinite;
}

@keyframes task-step-spin {
  100% { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .task-step-icon.running svg { animation: none; }
}

/* pending: a single hollow ring, no inner circle. */
.task-step-icon.pending {
  background: transparent;
  border: var(--status-pending-border);
}

/* pending 的空心环比常态是中性灰；只有可点的行才在悬停时染成强调色。
   展示用的清单（对话页任务编排）不做这个变化 —— 用户原本看到的就是
   「鼠标移上去，待处理的灰圆圈突然变成一圈紫色」。（用户反馈原话：「我 hover 为什么有蓝色？」） */
html[data-theme] .task-step-row.is-clickable:hover .task-step-icon.pending {
  border-color: var(--accent-primary);
  background: var(--accent-subtle);
}

/* Pending rows dim their text until work reaches them. */
.task-step-row.status-pending .task-step-content {
  opacity: 0.65;
}

.task-step-content {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-step-chip {
  flex: 0 0 auto;
  padding: 2px 7px;
  border-radius: 6px;
  background: var(--chrome-hover);
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 500;
  line-height: 1.4;
}

.task-step-icon.error { color: var(--status-danger-text); background: var(--status-danger-bg); }
.task-step-icon.cancelled { color: var(--text-tertiary); background: var(--bg-hover); }
.task-step-icon.error svg, .task-step-icon.cancelled svg { width: 13px; height: 13px; stroke-width: 2; }


/* ---- ../../components/ui/access-mode-menu.css ---- */
.ui-access-menu {
  position: absolute;
  z-index: 25;
  bottom: calc(100% + 9px);
  left: 0;
  width: 390px;
  max-width: calc(100vw - 48px);
  padding: 7px 5px;
  border: 0;
  border-radius: 12px;
  /* Retain the theme hue while making the menu completely opaque. */
  background: rgb(from var(--popover-bg) r g b / 1);
  color: var(--text-primary);
  box-shadow: var(--popover-shadow);
  box-sizing: border-box;
}
.ui-access-menu.is-inline { position: static; }
.ui-access-menu-heading { padding: 1px 11px 5px; color: var(--text-tertiary); font-size: 10.5px; }
.ui-access-menu-row { display: flex; align-items: center; gap: 10px; width: calc(100% - 12px); min-height: 45px; margin: 3px 6px; padding: 6px 10px; border: 0; border-radius: 9px; color: inherit; background: transparent; font: inherit; text-align: left; cursor: pointer; }
.ui-access-menu-row:hover, .ui-access-menu-row.is-selected { background: var(--popover-item-hover); }
.ui-access-menu-row > span { display: flex; flex: 1; flex-direction: column; gap: 2px; min-width: 0; }
.ui-access-menu-row b { font-size: 11px; font-weight: 400; }
.ui-access-menu-row small { color: var(--text-secondary); font-size: 9.5px; line-height: 1.3; }
.ui-access-menu-row > svg { flex: 0 0 auto; color: var(--text-secondary); }
.ui-access-menu-row.is-full b, .ui-access-menu-row.is-full > svg { color: var(--danger-text); }
.ui-access-menu-row:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: -2px; }

/* ==========================================================================
   基础重置
   ========================================================================== */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html,
body,
#root {
  height: 100%;
}

textarea {
  scrollbar-gutter: stable;
}

body {
  font-family: var(--font-sans);
  background: var(--bg-ambient);
  background-attachment: fixed;
  color: var(--text-primary);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.5;
  transition: background var(--transition-base), color var(--transition-base);
}

/* WebView / 浏览器会给原生表单控件钉上自带字体，统一继承界面字体。 */
button,
input,
select,
textarea,
optgroup,
option {
  font-family: inherit;
}

svg {
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
  max-width: 100%;
}

/* ==========================================================================
   键盘焦点
   --------------------------------------------------------------------------
   原 App 用一条全局 `outline: none` 把焦点环全清掉，再让 :focus-visible 复用
   「选中态」背景——结果键盘焦点和「已选中」长得一模一样（EXE 实测：按 Tab
   落到返回按钮上，按钮反而从实心变白，看起来更像不可点）。
   组件库改成：保留 :focus-visible 环，只在确实需要时用 accent 描边。
   ========================================================================== */
html[data-theme] :is(button, input, textarea, select, [role="tab"], [role="option"]):focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 2px;
}

/* ==========================================================================
   滚动条
   ========================================================================== */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) transparent;
}

*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

*::-webkit-scrollbar-track {
  background: var(--scrollbar-track);
  border-radius: var(--radius-full);
}

*::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: var(--radius-full);
  border: 2px solid transparent;
  background-clip: padding-box;
}

*::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
  border: 2px solid transparent;
  background-clip: padding-box;
}

/* ==========================================================================
   通用过渡动画（视图切换、淡入）
   ========================================================================== */
@keyframes fadeInView {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes global-notification-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
